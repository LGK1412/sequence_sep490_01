@startuml
skinparam {
    ActorBackgroundColor #FFFFFF
    BoundaryBackgroundColor #FFFFFF
    ControlBackgroundColor #FFFFFF
    EntityBackgroundColor #FFFFFF
    DatabaseBackgroundColor #FFFFFF

    ActorBorderColor black
    BoundaryBorderColor black
    ControlBorderColor black
    EntityBorderColor black
    DatabaseBorderColor black
}

actor User
boundary "Rating Like Button (UI)" as UI
boundary Router
control RatingController
control RatingLikeService
entity RatingLikeModel
entity RatingModel
database MongoDB

User -> UI: 1. Click Like / Unlike rating
activate User
activate UI

UI -> Router: 2. POST /rating/toggle
activate Router

Router -> RatingController: 3. toggle(ratingId)
activate RatingController

alt User role not authorized
    RatingController --> Router: 3.1.1. 401 Unauthorized
    Router --> UI: 3.1.2. Show error
    UI --> User: 3.1.3. Show error
else Rating missing
    RatingController --> Router: 3.2.1. 400 Bad Request
    Router --> UI: 3.2.2. Show error
    UI --> User: 3.2.3. Show error
else Invalid ratingId type
    RatingController --> Router: 3.3.1. 400 Bad Request
    Router --> UI: 3.3.2. Show error
    UI --> User: 3.3.3. Show error
else
end

RatingController -> RatingLikeService: 4. toggleLike(ratingId, userId)

activate RatingLikeService
RatingLikeService -> RatingLikeModel: 5. Find existing like
activate RatingLikeModel
RatingLikeModel -> MongoDB: 6. findOne({ ratingId, userId })
activate MongoDB
MongoDB --> RatingLikeModel: 7. Like document / null
deactivate MongoDB
RatingLikeModel --> RatingLikeService: 8. Existing like
deactivate RatingLikeModel

opt Already liked (UNLIKE)
    RatingLikeService -> RatingLikeModel: 8.1. deleteOne(existing like)
    activate RatingLikeModel
    RatingLikeModel -> MongoDB: 8.2. Delete like
    activate MongoDB
    MongoDB --> RatingLikeModel: 8.3. Delete result
    RatingLikeModel --> RatingLikeService: 8.4. Return result
    deactivate MongoDB
    deactivate RatingLikeModel

    RatingLikeService -> RatingModel: 8.5. Decrease likeCount
    activate RatingModel
    RatingModel -> MongoDB: 8.6. updateOne($inc -1)
    activate MongoDB
    MongoDB --> RatingModel: 8.7. Update result
    deactivate MongoDB
    RatingModel --> RatingLikeService: 8.8. Return result
    deactivate RatingModel

    RatingLikeService -> RatingModel: 8.9. Get current likeCount
    activate RatingModel
    RatingModel -> MongoDB: 8.10. findById select likeCount
    activate MongoDB
    MongoDB --> RatingModel: 8.11. Rating document
    deactivate MongoDB
    RatingModel --> RatingLikeService: 8.12. likeCount
    deactivate RatingModel
    RatingLikeService --> RatingController: 8.13. Return unliked & likesCount
    RatingController --> Router: 8.14. HTTP response
    Router --> UI: 8.15. Update like UI
    UI --> User: 8.16. Show like state
end


RatingLikeService -> RatingLikeModel: 16. Create like
activate RatingLikeModel
RatingLikeModel -> MongoDB: 17. Insert like
activate MongoDB
MongoDB --> RatingLikeModel: 18. Inserted
deactivate MongoDB
RatingLikeModel --> RatingLikeService: 18. Return created like
deactivate RatingLikeModel

RatingLikeService -> RatingModel: 19. Increase likeCount
activate RatingModel
RatingModel -> MongoDB: 20. updateOne($inc +1)
activate MongoDB
MongoDB --> RatingModel: 21. Update result
RatingModel --> RatingLikeService: 22. Return result
deactivate MongoDB
deactivate RatingModel


RatingLikeService -> RatingModel: 23. Get current likeCount
activate RatingModel
RatingModel -> MongoDB: 24. findById select likeCount
activate MongoDB
MongoDB --> RatingModel: 25. Rating document
deactivate MongoDB
RatingModel --> RatingLikeService: 26. likeCount
deactivate RatingModel

RatingLikeService --> RatingController: 27. Return liked & likesCount
deactivate RatingLikeService

RatingController --> Router: 28. HTTP response
deactivate RatingController
Router --> UI: 29. Update like UI
deactivate Router
UI --> User: 30. Show like state
deactivate UI
deactivate User
@enduml
