@startuml
skinparam {
  ActorBackgroundColor #FFFFFF
  BoundaryBackgroundColor #FFFFFF
  ControlBackgroundColor #FFFFFF
  EntityBackgroundColor #FFFFFF
  DatabaseBackgroundColor #FFFFFF
  ActorBorderColor black
  BoundaryBorderColor black
  ControlBorderColor black
  EntityBorderColor black
  DatabaseBorderColor black
}

actor User
boundary "Achievements Page" as FE
control AchievementController as AC
control AchievementService as AS
database MongoDB

User -> FE: 1. Open Achievements
activate User
activate FE

FE -> AC: 2. GET /api/achievements/me
activate AC
AC -> AC: 3. Guard check (AccessToken + Roles)

AC -> AS: 4. getAllWithProgress(userId)
activate AS

AS -> AS: 5. checkUser(userId)
alt 6. Invalid session / no permission / banned
  AS --> AC: 6.1 400 error
  AC --> FE: 6.2 Show error
else 7. OK
  AS -> MongoDB: 7.1 find progress (populate achievement)
  activate MongoDB
  MongoDB --> AS: 7.2 list (may be empty)
  deactivate MongoDB

  AS --> AC: 7.3 return list
  AC --> FE: 7.4 Render list / empty state
end

deactivate AS
deactivate AC
deactivate FE
deactivate User
@enduml