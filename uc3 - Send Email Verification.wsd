@startuml
skinparam {
    ActorBackgroundColor #FFFFFF
    BoundaryBackgroundColor #FFFFFF
    ControlBackgroundColor #FFFFFF
    EntityBackgroundColor #FFFFFF
    DatabaseBackgroundColor #FFFFFF

    ActorBorderColor black
    BoundaryBorderColor black
    ControlBorderColor black
    EntityBorderColor black
    DatabaseBorderColor black
}

actor User
boundary "Register / Login Page" as UI
boundary Router
control AuthController
control AuthService
control MailerService
control UserService
entity UserModel
database MongoDB

User -> UI: 1. Request email verification
activate User
activate UI

UI -> Router: 2. POST /api/auth/send-verify-email (email)
activate Router

Router -> AuthController: 3. sendVerifyEmail(email)
activate AuthController

AuthController -> AuthService: 4. sendVerificationEmail(email)

activate AuthService

alt Invalid email
    AuthService --> AuthController: 4.1.1 Throw BadRequestException
    AuthController --> Router: 4.1.2 HTTP 400 response
    Router --> UI: 4.1.3 Show invalid email error
    UI --> User: 4.1.4 Invalid email
else Rate limit exceeded
    AuthService --> AuthController: 4.2.1 Throw BadRequestException\n(Too many emails sent)
    AuthController --> Router: 4.2.2 HTTP 400 response
    Router --> UI: 4.2.3 Show rate limit error
    UI --> User: 4.2.4 Try again later
end

AuthService -> AuthService: 7. Generate verification token (JWT)
activate AuthService
AuthService -> MailerService: 8. Send verification email
deactivate AuthService
activate MailerService

MailerService --> AuthService: 9. Email sent / error
deactivate MailerService

opt Email service unavailable
    AuthService --> AuthController: 9.1 Throw InternalServerErrorException
    AuthController --> Router: 9.2 HTTP 500 response
    Router --> UI: 9.3 Show system error
    UI --> User: 9.4 Unable to send email
end

AuthService -> UserService: 10. Update user verify code
activate UserService
UserService -> UserModel: 11. update user verify code
activate UserModel
UserModel -> MongoDB: 12. update user verify code
activate MongoDB
MongoDB -> UserModel: 13. Return result
deactivate MongoDB
UserModel --> UserService: 14. Update success / error
deactivate UserModel
UserService --> AuthService: 15. Result
deactivate UserService

opt Verification info update failed
    AuthService --> AuthController: 15.1 Throw InternalServerErrorException
    AuthController --> Router: 15.2 HTTP 500 response
    Router --> UI: 15.3 Show system error
    UI --> User: 15.4 Verification update failed
end

AuthService --> AuthController: 16. Return success message
deactivate AuthService

AuthController --> Router: 17. HTTP 200 response
deactivate AuthController

Router --> UI: 18. Verification email sent
deactivate Router

UI --> User: 19. Check email inbox
deactivate UI
deactivate User
@enduml