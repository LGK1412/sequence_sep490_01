bottomparticipants

actor Admin
boundary "Genre Management UI" as UI
boundary Router
control GenreController
control GenreService
entity ":GenreModel" as GenreModel
entity ":MangaModel" as MangaModel
database MongoDB

Admin -> UI: 1. Open Genre Management page
activate Admin
activate UI

UI -> UI: 2. useEffect() call fetchGenres()
activate UI
space
deactivate UI

UI -> Router: 3. GET /genre
activate Router

Router -> Router: 4. Check token / role
activate Router
space
deactivate Router

alt Token invalid
    Router --> UI: 4.1.1 401 Unauthorized
    UI --> Admin: 4.1.2 Show error message
else Role invalid
    Router --> UI: 4.2.1 403 Forbidden
    UI --> Admin: 4.2.2 Show error message
end

Router -> GenreController: 5. getAllGenres()
activate GenreController

GenreController -> GenreService: 6. getAllGenres()
activate GenreService

GenreService -> GenreModel: 7. find().sort({name:1})
activate GenreModel
GenreModel -> MongoDB: 8. query genres
activate MongoDB
MongoDB --> GenreModel: 9. genres[]
deactivate MongoDB
GenreModel --> GenreService: 10. genres[]
deactivate GenreModel

GenreService -> MangaModel: 11. aggregate(unwind + group count)
activate MangaModel
MangaModel -> MongoDB: 12. run aggregate
activate MongoDB
MongoDB --> MangaModel: 13. counts[]
deactivate MongoDB
MangaModel --> GenreService: 14. counts[]
deactivate MangaModel

GenreService -> GenreService: 15. Merge counts, genres
activate GenreService
space
deactivate GenreService

GenreService --> GenreController: 16. genresWithStoriesCount[]
deactivate GenreService

GenreController --> Router: 17. HTTP 200 response
deactivate GenreController

Router --> UI: 18. Return genres list
deactivate Router

UI --> Admin: 19. Display genres with storiesCount

deactivate UI
deactivate Admin