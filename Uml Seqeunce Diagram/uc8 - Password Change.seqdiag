bottomparticipants

actor User
boundary "Change Password UI" as UI
boundary Router
control AuthController
control AuthService
control JwtService
boundary HashUtil

User -> UI: 1. Submit new password
activate User
activate UI

UI -> Router: 2. POST /auth/change-password
activate Router

Router -> AuthController: 3. changePassword(dto, req)
activate AuthController

AuthController -> AuthService: 4. changePassword(password, access_token)
activate AuthService

AuthService -> AuthService: 5. Check token
activate AuthService
space
deactivate AuthService

opt Missing token
    AuthService --> AuthController: 5.1. BadRequestException
    AuthController --> Router: 5.2. HTTP response
    Router --> UI: 5.3. Show error
    UI --> User: 5.4. Show error
end

AuthService -> JwtService: 6. verify(token)
activate JwtService

opt Invalid / expired token
    JwtService --> AuthService: 6.1. error
    AuthService --> AuthController: 6.2. BadRequestException
    AuthController --> Router: 6.3. HTTP response
    Router --> UI: 6.4. Show error
    UI --> User: 6.5. Show error
end

JwtService --> AuthService: 7. payload(email)
deactivate JwtService

ref over AuthService: 3.7.i. Subsequence - Find user for Password Recovery

AuthService -> AuthService: 8. Check user
activate AuthService
space
deactivate AuthService

opt User invalid / banned / google / not verified
    AuthService --> AuthController: 8.1. BadRequestException
    AuthController --> Router: 8.2. HTTP response
    Router --> UI: 8.3. Show error
    UI --> User: 8.4. Show error
end

AuthService -> HashUtil: 9. comparePassword(new, old)
activate HashUtil
HashUtil --> AuthService: 10. result
deactivate HashUtil

AuthService -> AuthService: 11. Check same password
activate AuthService
space
deactivate AuthService

opt Same password
    AuthService --> AuthController: 11.1. BadRequestException
    AuthController --> Router: 11.2. HTTP response
    Router --> UI: 11.3. Show error
    UI --> User: 11.4. Show error
end

ref over AuthService: 3.7.ii. Subsequence - Update new password

AuthService -> AuthService: 12. Check update
activate AuthService
space
deactivate AuthService

opt Update failed
    AuthService --> AuthController: 12.1. BadRequestException
    AuthController --> Router: 12.2. HTTP response
    Router --> UI: 12.3. Show error
    UI --> User: 12.4. Show error
end

AuthService --> AuthController: 13. success response
deactivate AuthService

AuthController --> Router: 14. HTTP response
deactivate AuthController
Router --> UI: 15. Show success message
deactivate Router
UI --> User: 16. Password updated successfully
deactivate UI
deactivate User