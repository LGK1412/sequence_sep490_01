bottomparticipants

actor "User/Author" as A
boundary "Check-in Modal" as UI
boundary Router
control "CheckinController" as Controller
entity "CheckinService" as Service
entity "CheckinModel" as CheckinModel
entity "UserModel" as UserModel
database MongoDB

A -> UI : 1. Click "Check-in" button
activate A
activate UI
UI -> Router : 2. POST /api/checkin/today
activate Router
Router -> Controller : 3. checkinToday(req)
activate Controller
Controller -> Service : 4. checkinToday(userId, role)
activate Service

Service -> CheckinModel : 5. findOneAndUpdate(upsert record)
activate CheckinModel
CheckinModel -> MongoDB : 6. Execute query
activate MongoDB
MongoDB --> CheckinModel : 7. document
deactivate MongoDB
CheckinModel --> Service : 8. record
deactivate CheckinModel

alt already checked
    Service --> Controller : 8.1.1. BadRequestException
    Controller --> Router : 8.1.2. HTTP response (400 error)
    Router --> UI : 8.1.3. error message
    UI --> A : 8.1.4. Display "Already checked\n in today!" message
else not checked
    Service -> UserModel : 8.2.1. Find user
    activate UserModel
    UserModel -> MongoDB : 8.2.2. Execute query
    activate MongoDB
    MongoDB --> UserModel : 8.2.3. document
    deactivate MongoDB
    UserModel --> Service : 8.2.4. user
    deactivate UserModel
    Service -> CheckinModel : 8.2.5. Save record
    activate CheckinModel
    CheckinModel --> Service : 8.2.6. success
    deactivate CheckinModel
    Service -> UserModel : 8.2.7. updated points
    activate UserModel
    UserModel --> Service: 8.2.8. success
    deactivate UserModel
    Service --> Controller : 8.2.9. success
    deactivate Service
    Controller --> Router : 8.2.10. HTTP response (200 OK)
    deactivate Controller
    Router --> UI : 8.2.11. success message
    deactivate Router
    UI --> A : 8.2.12. Disable "Check-in" button &\n Mark and claim reward
    deactivate UI
    deactivate A
end
@enduml
