bottomparticipants

actor Staff
boundary "ReportsPage / ReportDetail UI" as UI
boundary Router
control ReportsController
control ReportsService
entity ":ReportsModel" as ReportsModel
entity ":UsersModel" as UsersModel
entity ":MangaModel" as MangaModel
entity ":ChaptersModel" as ChaptersModel
entity ":CommentsModel" as CommentsModel
entity ":RepliesModel" as RepliesModel
database MongoDB

Staff -> UI: 1. Click "View" on report row
activate Staff
activate UI

UI -> UI: 2. Open modal (show basic info)
activate UI
space
deactivate UI

UI -> Router: 3. GET /api/reports/{id}
activate Router

Router -> ReportsController: 4. findOne(id, role)
activate ReportsController

ReportsController -> ReportsService: 5. findOneForRole(id, role)
activate ReportsService

ReportsService -> ReportsModel: 6. findById(id) + populate(reporter_id, target_id)
activate ReportsModel
ReportsModel -> MongoDB: 7. query report + populate refs
activate MongoDB
MongoDB --> ReportsModel: 8. reportDoc / null
deactivate MongoDB
ReportsModel --> ReportsService: 9. reportDoc
deactivate ReportsModel

ReportsService -> ReportsService: 10. Check type
activate ReportsService
space
deactivate ReportsService

alt target_type == Manga
  ReportsService -> MangaModel: 10.1.1. findById(target_id)
  activate MangaModel
  MangaModel -> MongoDB: 10.1.2. query manga
  activate MongoDB
  MongoDB --> MangaModel: 10.1.3. manga
  deactivate MongoDB
  MangaModel --> ReportsService: 10.1.4. manga
  deactivate MangaModel

  ReportsService -> UsersModel: 10.2.1. findById(manga.authorId)
  activate UsersModel
  UsersModel -> MongoDB: 10.2.2. query author
  activate MongoDB
  MongoDB --> UsersModel: 10.2.3. author
  deactivate MongoDB
  UsersModel --> ReportsService: 10.2.4. author
  deactivate UsersModel

else target_type == Chapter
  ReportsService -> ChaptersModel: 10.3.1. findById(target_id)
  activate ChaptersModel
  ChaptersModel -> MongoDB: 10.3.2. query chapter
  activate MongoDB
  MongoDB --> ChaptersModel: 10.3.3. chapter
  deactivate MongoDB
  ChaptersModel --> ReportsService: 10.3.4. chapter
  deactivate ChaptersModel

  ReportsService -> MangaModel: 10.3.5. findById(chapter.manga_id)
  activate MangaModel
  MangaModel -> MongoDB: 10.3.6. query manga
  activate MongoDB
  MongoDB --> MangaModel: 10.3.7. manga
  deactivate MongoDB
  MangaModel --> ReportsService: 10.3.8. manga
  deactivate MangaModel

  ReportsService -> UsersModel: 10.3.9. findById(manga.authorId)
  activate UsersModel
  UsersModel -> MongoDB: 10.3.10. query author
  activate MongoDB
  MongoDB --> UsersModel: 10.3.11. author
  deactivate MongoDB
  UsersModel --> ReportsService: 10.3.12. author
  deactivate UsersModel

else target_type == Comment
  ReportsService -> CommentsModel: 10.4.1. findById(target_id)
  activate CommentsModel
  CommentsModel -> MongoDB: 10.4.2. query comment
  activate MongoDB
  MongoDB --> CommentsModel: 10.4.3. comment
  deactivate MongoDB
  CommentsModel --> ReportsService: 10.4.4. comment
  deactivate CommentsModel

  ReportsService -> UsersModel: 10.4.5. findById(comment.user_id)
  activate UsersModel
  UsersModel -> MongoDB: 10.4.6. query user
  activate MongoDB
  MongoDB --> UsersModel: 10.4.7. user
  deactivate MongoDB
  UsersModel --> ReportsService: 10.4.8. user
  deactivate UsersModel

else target_type == Reply
  ReportsService -> RepliesModel: 10.5.1. findById(target_id)
  activate RepliesModel
  RepliesModel -> MongoDB: 10.5.2. query reply
  activate MongoDB
  MongoDB --> RepliesModel: 10.5.3. reply
  deactivate MongoDB
  RepliesModel --> ReportsService: 10.5.4. reply
  deactivate RepliesModel

  ReportsService -> UsersModel: 10.5.5. findById(reply.user_id)
  activate UsersModel
  UsersModel -> MongoDB: 10.5.6. query user
  activate MongoDB
  MongoDB --> UsersModel: 10.5.7. user
  deactivate MongoDB
  UsersModel --> ReportsService: 10.5.8. user
  deactivate UsersModel
end

ReportsService --> ReportsController: 11. reportDetail
deactivate ReportsService

ReportsController --> Router: 12. 200 OK + reportDetail
deactivate ReportsController

Router --> UI: 13. reportDetail
deactivate Router

UI -> UI: 14. setSelectedReport(reportDetail)
activate UI
space
deactivate UI

UI --> Staff: 15. Show result
deactivate UI
deactivate Staff

@enduml