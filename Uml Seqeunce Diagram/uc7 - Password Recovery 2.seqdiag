bottomparticipants

actor User
boundary "Reset Password UI" as UI
boundary Router
control AuthController
control AuthService
control JwtService

User -> UI: 1. Submit new password + verification code
activate User
activate UI

UI -> Router: 2. POST /auth/verify-forgot-password
activate Router

Router -> AuthController: 3. verificationForgotPassword(code, password)
activate AuthController

AuthController -> AuthService: 4. verificationForgotPassword(token, password)
activate AuthService

AuthService -> AuthService: 5. Check token
activate AuthService
space
deactivate AuthService

opt Missing token
    AuthService --> AuthController: 5.1. BadRequestException
    AuthController --> Router: 5.2. Return error
    Router --> UI: 5.3. Return error
    UI --> User: 5.4. Show error
end

AuthService -> JwtService: 6. verify(token)
activate JwtService

opt Invalid / expired token
    JwtService --> AuthService: 6.1. Return error
    AuthService --> AuthController: 6.2. BadRequestException
    AuthController --> Router: 6.3. Return error
    Router --> UI: 6.4. Return error
    UI --> User: 6.5. Show error
end

JwtService --> AuthService: 7. payload
deactivate JwtService

AuthService -> AuthService: 8. Check payload
activate AuthService
space
deactivate AuthService

opt Invalid payload
    AuthService --> AuthController: 8.1. BadRequestException
    AuthController --> Router: 8.2. Return error
    Router --> UI: 8.3. Return error
    UI --> User: 8.4. Show error
end

ref over AuthService: 3.7.ii. Subsequence - Find user for Password Recovery

AuthService -> AuthService: 9. Check user
activate AuthService
space
deactivate AuthService

opt User invalid
    AuthService --> AuthController: 9.1. BadRequestException
    AuthController --> Router: 9.2. Return error
    Router --> UI: 9.3. Return error
    UI --> User: 9.4. Show error
end

ref over AuthService: 3.7.ii. Subsequence - Update new password

AuthService -> AuthService: 10. Check update
activate AuthService
space
deactivate AuthService

opt Update failed
    AuthService --> AuthController: 10.1. BadRequestException
    AuthController --> Router: 10.2. Return error
    Router --> UI: 10.3. Return error
    UI --> User: 10.4. Show error
end

AuthService --> AuthController: 11. success response
deactivate AuthService

AuthController --> Router: 12. HTTP response
deactivate AuthController
Router --> UI: 13. Show success message
deactivate Router
UI --> User: 14. Password updated successfully
deactivate UI
deactivate User