bottomparticipants

actor Author
boundary "Update Manga UI" as UI
boundary Router
control MangaController
control MangaService
control StylesService
entity ":MangaModel" as MangaModel
database MongoDB

Author -> UI: 1. Submit update manga form
activate Author
activate UI

UI -> Router: 2. PATCH /update/{mangaId}
activate Router

Router -> MangaController: 3. updateManga(mangaId, dto, file, req)
activate MangaController

MangaController -> MangaController: 4. Check token / role
activate MangaController
space
deactivate MangaController

alt Token invalid
    MangaController --> Router: 4.1.1 401 Unauthorized
    Router --> UI: 4.1.2 Show error
    UI --> Author: 4.1.3 Error message
else Role invalid
    MangaController --> Router: 4.2.1 403 Forbidden
    Router --> UI: 4.2.2 Show error
    UI --> Author: 4.2.3 Error message
end

MangaController -> MangaController: 5. Check permission (authorId vs req.user)
activate MangaController
space
deactivate MangaController

opt No permission
    MangaController --> Router: 5.1 401 Unauthorized
    Router --> UI: 5.2 Show error
    UI --> Author: 5.3 Error message
end

MangaController -> MangaService: 6. updateManga(mangaId, dto, authorId)
activate MangaService

MangaService -> MangaService: 7. Check mangaId valid
activate MangaService
space
deactivate MangaService

opt Invalid mangaId
    MangaService --> MangaController: 7.1 BadRequestException
    MangaController --> Router: 7.2 Error response
    Router --> UI: 7.3 Show error
    UI --> Author: 7.4 Error message
end

MangaService -> MangaService: 8. Check styles valid
activate MangaService
space
deactivate MangaService

opt Validate styles
    MangaService -> StylesService: 8.1 findById(styleId)
    activate StylesService
    StylesService --> MangaService: 8.2 style / null
    deactivate StylesService

    MangaService -> MangaService: 8.3 Check style existence / visibility
    activate MangaService
    space
    deactivate MangaService

    alt Style not exist
        MangaService --> MangaController: 8.3.1 BadRequestException
        MangaController --> Router: 8.3.2 Error response
        Router --> UI: 8.3.3 Show error
        UI --> Author: 8.3.4 Error message
    else Style is hidden
        MangaService --> MangaController: 8.3.5 BadRequestException
        MangaController --> Router: 8.3.6 Error response
        Router --> UI: 8.3.7 Show error
        UI --> Author: 8.3.8 Error message
    end
end

MangaService -> MangaModel: 9. updateOne({_id, authorId}, dto)
activate MangaModel
MangaModel -> MongoDB: 10. update document
activate MongoDB
MongoDB --> MangaModel: 11. update result
deactivate MongoDB
MangaModel --> MangaService: 12. modifiedCount
deactivate MangaModel

MangaService -> MangaService: 13. Check update success
activate MangaService
space
deactivate MangaService

opt Update failed
    MangaService --> MangaController: 13.1 BadRequestException
    MangaController --> Router: 13.2 Error response
    Router --> UI: 13.3 Show error
    UI --> Author: 13.4 Error message
end

MangaService -> MangaModel: 14. findById(id)
activate MangaModel
MangaModel -> MongoDB: 15. query manga
activate MongoDB
MongoDB --> MangaModel: 16. manga document
deactivate MongoDB
MangaModel --> MangaService: 17. manga
deactivate MangaModel

MangaService --> MangaController: 18. updated manga
deactivate MangaService

MangaController -> MangaController: 19. Check has cover file
activate MangaController
space
deactivate MangaController

opt Update manga cover
    MangaController -> MangaController: 19.1 save manga cover image
    activate MangaController
    space
    deactivate MangaController
end

MangaController --> Router: 20. HTTP response
deactivate MangaController

Router --> UI: 21. Show updated manga
deactivate Router

UI --> Author: 22. Manga updated successfully
deactivate UI
deactivate Author