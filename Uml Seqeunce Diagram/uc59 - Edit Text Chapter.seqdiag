bottomparticipants

actor Author
boundary "Update Chapter UI" as UI
boundary Router
control TextChapterController
control TextChapterService
entity ":ChapterModel" as ChapterModel
entity ":TextChapterModel" as TextChapterModel
entity ":MangaModel" as MangaModel
database MongoDB

Author -> UI: 1. Submit update chapter form
activate Author
activate UI

UI -> Router: 2. PATCH /chapter/{id}
activate Router

Router -> TextChapterController: 3. update(id, dto)
activate TextChapterController

TextChapterController -> TextChapterController: 4. Check token / role
activate TextChapterController
space
deactivate TextChapterController

alt Token invalid
    TextChapterController --> Router: 4.1.1 401 Unauthorized
    Router --> UI: 4.1.2 Show error
    UI --> Author: 4.1.3 Error message
else Role invalid
    TextChapterController --> Router: 4.2.1 403 Forbidden
    Router --> UI: 4.2.2 Show error
    UI --> Author: 4.2.3 Error message
end

TextChapterController -> TextChapterService: 5. updateChapter(id, dto)
activate TextChapterService

TextChapterService -> ChapterModel: 6. findById(id)
activate ChapterModel
ChapterModel -> MongoDB: 7. query chapter
activate MongoDB
MongoDB --> ChapterModel: 8. chapter / null
deactivate MongoDB
ChapterModel --> TextChapterService: 9. oldChapter
deactivate ChapterModel

TextChapterService -> TextChapterService: 10. Check chapter existence
activate TextChapterService
space
deactivate TextChapterService

opt Chapter not found
    TextChapterService --> TextChapterController: 10.1 BadRequestException
    TextChapterController --> Router: 10.2 Error response
    Router --> UI: 10.3 Show error
    UI --> Author: 10.4 Error message
end

TextChapterService -> TextChapterService: 11. Check if order changed
activate TextChapterService
space
deactivate TextChapterService

opt Order changed
    TextChapterService -> ChapterModel: 11.1. findOne(manga_id, order)
    activate ChapterModel
    ChapterModel -> MongoDB: 11.2. query conflict
    activate MongoDB
    MongoDB --> ChapterModel: 11.3. chapter / null
    deactivate MongoDB
    ChapterModel --> TextChapterService: 11.4. existingChapter
    deactivate ChapterModel

    TextChapterService -> TextChapterService: 11.5. Check order conflict
    activate TextChapterService
    space
    deactivate TextChapterService

    opt Order conflict
        TextChapterService --> TextChapterController: 11.5.1. BadRequestException
        TextChapterController --> Router: 11.5.2. Error response
        Router --> UI: 11.5.3. Show error
        UI --> Author: 11.5.4. Error message
    end
end

TextChapterService -> ChapterModel: 12. findByIdAndUpdate(id, chapter fields)
activate ChapterModel
ChapterModel -> MongoDB: 13. update chapter
activate MongoDB
MongoDB --> ChapterModel: 14. updated chapter
deactivate MongoDB
ChapterModel --> TextChapterService: 15. chapter
deactivate ChapterModel

TextChapterService -> TextChapterService: 16. Check if text needs update
activate TextChapterService
space
deactivate TextChapterService

opt Update text chapter
    TextChapterService -> TextChapterModel: 16.1. findOneAndUpdate(chapter_id, content)
    activate TextChapterModel
    TextChapterModel -> MongoDB: 16.2. update text chapter
    activate MongoDB
    MongoDB --> TextChapterModel: 16.3. updated text
    deactivate MongoDB
    TextChapterModel --> TextChapterService: 16.4. textChapter
    deactivate TextChapterModel
end

TextChapterService -> TextChapterService: 17. Check if content or title changed
activate TextChapterService
space
deactivate TextChapterService

opt Content or title changed
    ref over TextChapterService, MongoDB: 3.59.b.i. Subseqeunce - Add to queue for AI check policies
    ref over TextChapterService, MongoDB: 3.59.b.ii. Subseqeunce - AI check policies
end

TextChapterService -> TextChapterService: 18. Check if publishing
activate TextChapterService
space
deactivate TextChapterService

opt Publish chapter (false -> true)
    TextChapterService -> MangaModel: 18.1. findById(manga_id)
    activate MangaModel
    MangaModel -> MongoDB: 18.2. query manga
    activate MongoDB
    MongoDB --> MangaModel: 18.3. manga
    deactivate MongoDB
    MangaModel --> TextChapterService: 18.4. manga
    deactivate MangaModel
end

TextChapterService --> TextChapterController: 19. {chapter, text}
deactivate TextChapterService

TextChapterController --> Router: 20. HTTP response
deactivate TextChapterController
Router --> UI: 21. Show updated chapter
deactivate Router
UI --> Author: 22. Chapter updated successfully
deactivate UI
deactivate Author