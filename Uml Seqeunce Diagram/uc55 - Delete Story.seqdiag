bottomparticipants

actor Author
boundary "Manage Manga UI" as UI
boundary Router
control MangaController
control MangaService
entity ":MangaModel" as MangaModel
database MongoDB

Author -> UI: 1. Click Toggle Delete / Restore
activate Author
activate UI

UI -> Router: 2. POST /{mangaId}/toggle-delete
activate Router

Router -> MangaController: 3. toggleDelete(mangaId, req)
activate MangaController

MangaController -> MangaController: 4. Check token / role
activate MangaController
space
deactivate MangaController

alt Token Invalid
    MangaController --> Router: 4.1.1 401 Unauthorized
    Router --> UI: 4.1.2 Show error
    UI --> Author: 4.1.3 Error message
else Role Invalid
    MangaController --> Router: 4.2.1 403 Forbidden
    Router --> UI: 4.2.2 Show error
    UI --> Author: 4.2.3 Error message
end

MangaController -> MangaController: 5. Check permission (authorId vs req.user)
activate MangaController
space
deactivate MangaController

opt No permission
    MangaController --> Router: 5.1 401 Unauthorized
    Router --> UI: 5.2 Show error
    UI --> Author: 5.3 Error message
end

MangaController -> MangaService: 6. toggleDelete(mangaId, authorId)
activate MangaService

MangaService -> MangaService: 7. Check mangaId valid
activate MangaService
space
deactivate MangaService

opt Invalid mangaId
    MangaService --> MangaController: 7.1 BadRequestException
    MangaController --> Router: 7.2 Error response
    Router --> UI: 7.3 Show error
    UI --> Author: 7.4 Error message
end

MangaService -> MangaService: 8. Validate ownership query
activate MangaService
space
deactivate MangaService

MangaService -> MangaModel: 9. findOne({_id, authorId})
activate MangaModel
MangaModel -> MongoDB: 10. query manga
activate MongoDB
MongoDB --> MangaModel: 11. manga / null
deactivate MongoDB
MangaModel --> MangaService: 12. result
deactivate MangaModel

MangaService -> MangaService: 13. Check manga existence / ownership
activate MangaService
space
deactivate MangaService

opt Manga not exist or not owned
    MangaService --> MangaController: 13.1 BadRequestException
    MangaController --> Router: 13.2 Error response
    Router --> UI: 13.3 Show error
    UI --> Author: 13.4 Error message
end

MangaService -> MangaService: 14. Toggle isDeleted flag
activate MangaService
space
deactivate MangaService

MangaService -> MangaModel: 15. updateOne({_id, authorId}, isDeleted)
activate MangaModel
MangaModel -> MongoDB: 16. update document
activate MongoDB
MongoDB --> MangaModel: 17. update success
deactivate MongoDB
MangaModel --> MangaService: 18. updated manga
deactivate MangaModel

MangaService -> MangaService: 19. Check update success
activate MangaService
space
deactivate MangaService

opt Update failed
    MangaService --> MangaController: 19.1 BadRequestException
    MangaController --> Router: 19.2 Error response
    Router --> UI: 19.3 Show error
    UI --> Author: 19.4 Error message
end

MangaService -> MangaModel: 20. findById(id)
activate MangaModel
MangaModel -> MongoDB: 21. query updated manga
activate MongoDB
MongoDB --> MangaModel: 22. manga document
deactivate MongoDB
MangaModel --> MangaService: 23. manga
deactivate MangaModel

MangaService --> MangaController: 24. updated manga
deactivate MangaService

MangaController --> Router: 25. HTTP response
deactivate MangaController

Router --> UI: 26. Update manga status
deactivate Router

UI --> Author: 27. See delete/restore result
deactivate UI
deactivate Author