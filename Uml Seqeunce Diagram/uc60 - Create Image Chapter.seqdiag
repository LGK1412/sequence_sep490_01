bottomparticipants

actor Author
boundary "Create Image Chapter UI" as UI
boundary Router
control ImageChapterController
control ImageChapterService
entity ":ChapterModel" as ChapterModel
entity ":ImageChapterModel" as ImageChapterModel
entity ":MangaModel" as MangaModel
database MongoDB
boundary FileSystem
boundary Sharp

Author -> UI: 1. Submit create image chapter form (images)
activate Author
activate UI

UI -> Router: 2. POST /chapter-image
activate Router

Router -> ImageChapterController: 3. create(dto, files)
activate ImageChapterController

ImageChapterController -> ImageChapterController: 4. Check token / role
activate ImageChapterController
space
deactivate ImageChapterController

alt Token invalid
    ImageChapterController --> Router: 4.1.1 401 Unauthorized
    Router --> UI: 4.1.2 Show error
    UI --> Author: 4.1.3 Error message
else Role invalid
    ImageChapterController --> Router: 4.2.1 403 Forbidden
    Router --> UI: 4.2.2 Show error
    UI --> Author: 4.2.3 Error message
end

ImageChapterController -> ImageChapterService: 5. createChapterWithImages(dto, files)
activate ImageChapterService

ImageChapterService -> ChapterModel: 6. create(chapter)
activate ChapterModel
ChapterModel -> MongoDB: 7. insert chapter
activate MongoDB
MongoDB --> ChapterModel: 8. chapter document
deactivate MongoDB
ChapterModel --> ImageChapterService: 9. chapter
deactivate ChapterModel

ImageChapterService -> FileSystem: 10. create chapter image directory
activate FileSystem
FileSystem --> ImageChapterService: 11. directory ready
deactivate FileSystem

loop For each image
    ImageChapterService -> Sharp: 11.1. convert buffer → webp
    activate Sharp
    Sharp --> ImageChapterService: 11.2. saved image file
    deactivate Sharp
end

ImageChapterService -> ImageChapterModel: 12. findOne(chapter_id)
activate ImageChapterModel
ImageChapterModel -> MongoDB: 13. query imageChapter
activate MongoDB
MongoDB --> ImageChapterModel: 14. imageChapter / null
deactivate MongoDB
ImageChapterModel --> ImageChapterService: 15. imageChapter
deactivate ImageChapterModel

ImageChapterService -> ImageChapterService: 16. Check ImageChapter existence
activate ImageChapterService
space
deactivate ImageChapterService

alt ImageChapter exists
    ImageChapterService -> ImageChapterModel: 16.1. save(updated images)
    activate ImageChapterModel
    ImageChapterModel -> MongoDB: 16.2. update document
    activate MongoDB
    MongoDB --> ImageChapterModel: 16.3. result
    deactivate MongoDB
    ImageChapterModel --> ImageChapterService: 16.4. result
    deactivate ImageChapterModel
else ImageChapter not exist
    ImageChapterService -> ImageChapterModel: 16.5. create(imageChapter)
    activate ImageChapterModel
    ImageChapterModel -> MongoDB: 16.6. insert document
    activate MongoDB
    MongoDB --> ImageChapterModel: 16.7. imageChapter
    deactivate MongoDB
    ImageChapterModel --> ImageChapterService: 16.8. imageChapter
    deactivate ImageChapterModel

    ImageChapterService -> MangaModel: 16.9. findById(manga_id)
    activate MangaModel
    MangaModel -> MongoDB: 16.10. query manga
    activate MongoDB
    MongoDB --> MangaModel: 16.11. manga
    deactivate MongoDB
    MangaModel --> ImageChapterService: 16.12. manga
    deactivate MangaModel
end

ImageChapterService --> ImageChapterController: 17. {chapter, imageChapter}
deactivate ImageChapterService

ImageChapterController --> Router: 18. HTTP 201 response
deactivate ImageChapterController
Router --> UI: 19. Show created image chapter
deactivate Router
UI --> Author: 20. Create image chapter success
deactivate UI
deactivate Author