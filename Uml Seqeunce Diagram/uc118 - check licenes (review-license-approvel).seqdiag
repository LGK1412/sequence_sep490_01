bottompariticipants

actor "Content Moderator" as Moderator
boundary "Content Management UI" as UI
boundary Router
control MangaController
control MangaService
entity ":MangaModel" as MangaModel
database MongoDB

ref over Moderator, MongoDB: 1. Subsequence - Get license queue for content moderation
activate Moderator
activate UI
activate Router
activate MangaController
activate MangaService
activate MangaModel
activate MongoDB
ref over Moderator, MongoDB: 2. title Subsequence - Get detailed license information for a story
deactivate Moderator
deactivate UI
deactivate Router
deactivate MangaController
deactivate MangaService
deactivate MangaModel
deactivate MongoDBd

Moderator -> UI: 3. Click "Approve"
activate Moderator
activate UI

UI -> Router: 4. PATCH /api/manga/admin/license/{mangaId}/review\n{status:"approved", publishAfterApprove:true}
activate Router

Router -> MangaController: 5. reviewLicense(mangaId, dto, req)
activate MangaController

MangaController -> MangaService: 6. reviewLicense(mangaId, reviewerId, approved, "", true)
activate MangaService

opt Invalid mangaId / reviewerId / review status
  MangaService --> MangaController: 6.1. Throw BadRequest
  MangaController --> Router: 6.2. HTTP 400
  Router --> UI: 6.3. Approve failed
  UI --> Moderator: 6.4. Show error message
end

MangaService -> MangaModel: 7. findById(mangaId)
activate MangaModel
MangaModel -> MongoDB: 8. Query story
activate MongoDB
MongoDB --> MangaModel: 9. Manga document / null
deactivate MongoDB
MangaModel --> MangaService: 10. Return manga
deactivate MangaModel

opt Manga not found
  MangaService --> MangaController: 10.1.1. Throw NotFound
  MangaController --> Router: 10.1.2. HTTP 404
  Router --> UI: 10.1.3. Approve failed
  UI --> Moderator: 10.1.4. Show error message
end

opt License is not pending
  MangaService --> MangaController: 10.2.1. Throw BadRequest("License is not in pending state")
  MangaController --> Router: 10.2.2. HTTP 400
  Router --> UI: 10.2.3. Approve failed
  UI --> Moderator: 10.2.4. Show error message
end

opt publishAfterApprove = true AND story suspended/banned
  MangaService --> MangaController: 10.3.1. Throw BadRequest("Cannot publish after approve...")
  MangaController --> Router: 10.3.2. HTTP 400
  Router --> UI: 10.3.3. Approve failed
  UI --> Moderator: 10.3.4. Show error message
end

MangaService -> MangaModel: 11. save(licenseStatus=approved,\nlicenseReviewedAt, licenseReviewedBy,\nlicenseRejectReason="", isPublish=true)
activate MangaModel
MangaModel -> MongoDB: 12. Update document
activate MongoDB
MongoDB --> MangaModel: 13. Saved
deactivate MongoDB
MangaModel --> MangaService: 14. Updated manga
deactivate MangaModel

MangaService --> MangaController: 15. Return success payload
deactivate MangaService

MangaController --> Router: 16. HTTP 200 response
deactivate MangaController

Router --> UI: 17. Approve success
deactivate Router

UI --> Moderator: 18. Show approved result
deactivate UI
deactivate Moderator