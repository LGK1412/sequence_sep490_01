bottomparticipants

actor User
boundary "Forgot Password UI" as UI
boundary Router
control AuthController
control AuthService
control JwtService
control MailerService

User -> UI: 1. Submit forgot password (email)
activate User
activate UI

UI -> Router: 2. POST /auth/forgot-password
activate Router

Router -> AuthController: 3. call send email
activate AuthController

AuthController -> AuthService: 4. call send email
activate AuthService

AuthService -> AuthService: 5. Check email
activate AuthService
space
deactivate AuthService

opt Email invalid
    AuthService --> AuthController: 5.1. BadRequestException
    AuthController --> Router: 5.2. Return error
    Router --> UI: 5.3. Return error
    UI --> User: 5.4. Show error
end

ref over AuthService: 3.7.b.i.  Subsequence - Find user for Password recovery

AuthService -> AuthService: 6. Check user
activate AuthService
space
deactivate AuthService

opt Invalid user
    AuthService --> AuthController: 6.1. BadRequestException
    AuthController --> Router: 6.2. Return error
    Router --> UI: 6.3. Return error
    UI --> User: 6.4. Show error
end

AuthService -> JwtService: 7. sign({email, action}, 15m)
activate JwtService
JwtService --> AuthService: 8. token
deactivate JwtService

AuthService -> MailerService: 9. send email
activate MailerService
MailerService --> AuthService: 10. mail sent
deactivate MailerService

AuthService -> AuthService: 11. Check sent success
activate AuthService
space
deactivate AuthService

opt Send mail failed
    AuthService --> AuthController: 11.1. InternalServerErrorException
    AuthController --> Router: 11.2. Return error
    Router --> UI: 11.3. Return error
    UI --> User: 11.4. Show error
end

ref over AuthService: 3.7.b.ii. Subsequence - Update verify code

AuthService -> AuthService: 12. Check update
activate AuthService
space
deactivate AuthService

opt Update failed
    AuthService --> AuthController: 12.1. InternalServerErrorException
    AuthController --> Router: 12.2. Return error
    Router --> UI: 12.3. Return error
    UI --> User: 12.4. Show error
end

AuthService --> AuthController: 13. Return success response
deactivate AuthService

AuthController --> Router: 14. Return HTTP response
deactivate AuthController
Router --> UI: 15. Show success message
deactivate Router
UI --> User: 16. Verification email sent
deactivate UI
deactivate User