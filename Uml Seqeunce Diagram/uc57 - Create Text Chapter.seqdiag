bottomparticipants

actor Author
boundary "Create Chapter UI" as UI
boundary Router
control TextChapterController
control TextChapterService
entity ":TextChapterModel" as TextChapterModel
entity ":TextTextChapterModel" as TextTextChapterModel
entity ":MangaModel" as MangaModel
database MongoDB

