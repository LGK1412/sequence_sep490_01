bottomparticipants

actor User
boundary "Achievements Page" as UI
boundary Router
control AchievementController
control AchievementService
entity AchievementModel
entity ":AchievementProgressModel" as AchievementProgressModel
entity UserModel
database MongoDB

User -> UI: 1. Click "Claim Reward"
activate User
activate UI

UI -> Router: 2. POST /api/achievement/{id}/claim
activate Router

Router -> AchievementController: 3. call claim reward
activate AchievementController

AchievementController -> AchievementService: 4. call claim reward
activate AchievementService

AchievementService -> AchievementService: 5. Check userId / achievementId
activate AchievementService
space
deactivate AchievementService

loop Invalid userId / achievementId
  AchievementService --> AchievementController: 5.1. BadRequestException
  AchievementController --> Router: 5.2. HTTP error
  Router --> UI: 5.3. Show error
  UI --> User: 5.4. Show error
end

AchievementService -> AchievementModel: 6. findById(achievementId)
activate AchievementModel
AchievementModel -> MongoDB: 7. query achievement
activate MongoDB
MongoDB --> AchievementModel: 8. achievement data
deactivate MongoDB
AchievementModel --> AchievementService: 9. return achievement
deactivate AchievementModel

AchievementService -> AchievementService: 10. Check achievement
activate AchievementService
space
deactivate AchievementService

loop Achievement not found / inactive
  AchievementService --> AchievementController: 10.1. NotFound / BadRequest
  AchievementController --> Router: 10.2. HTTP error
  Router --> UI: 10.3. Show error
  UI --> User: 10.4. Show error
end

AchievementService -> AchievementProgressModel: 11. findOne(userId, achievementId)
activate AchievementProgressModel
AchievementProgressModel -> MongoDB: 12. query progress
activate MongoDB
MongoDB --> AchievementProgressModel: 13. progress data
deactivate MongoDB
AchievementProgressModel --> AchievementService: 14. return progress
deactivate AchievementProgressModel

AchievementService -> AchievementService: 15. Check progress
activate AchievementService
space
deactivate AchievementService

loop Progress not found / not completed / reward claimed
  AchievementService --> AchievementController: 15.1. BadRequest / NotFound
  AchievementController --> Router: 15.2. HTTP error
  Router --> UI: 15.3. Show error
  UI --> User: 15.4. Show error
end

AchievementService -> UserModel: 16. findByIdAndUpdate(+point, +author_point)
activate UserModel
UserModel -> MongoDB: 17. update user points
activate MongoDB
MongoDB --> UserModel: 18. update success
deactivate MongoDB
UserModel --> AchievementService: 19. return
deactivate UserModel

AchievementService -> AchievementProgressModel: 20. save rewardClaimed = true
activate AchievementProgressModel
AchievementProgressModel -> MongoDB: 21. update progress
activate MongoDB
MongoDB --> AchievementProgressModel: 22. saved
deactivate MongoDB
AchievementProgressModel --> AchievementService: 23. return
deactivate AchievementProgressModel

AchievementService --> AchievementController: 24. success result
deactivate AchievementService

AchievementController --> Router: 25. HTTP success response
deactivate AchievementController

Router --> UI: 26. Response data
deactivate Router
UI --> User: 27. Show success & reward
deactivate UI
deactivate User