bottomparticipants

actor Author
boundary "Text Chapter UI" as TextChapter
boundary "Translator Text Chapter UI" as TranslatorPanel
control "Router" as Router
control "get-novel-translation" as GetNovel
control "fast-novel-translation" as FastNovel
control "save-novel-translation" as SaveNovel

Author -> TextChapter: 1. Click translate icon
activate Author
activate TextChapter
TextChapter -> TranslatorPanel: 2. Select target language
activate TranslatorPanel
TranslatorPanel -> Router: 3. Check translation cache
activate Router

Router -> GetNovel: 4. POST /get-novel-translation
activate GetNovel

opt Server / Network Error
    GetNovel --> Router: 4.1. Timeout / Connection error
    Router --> TranslatorPanel: 4.2. HTTP error
    TranslatorPanel --> TextChapter: 4.3. Show "Translation failed"
    TextChapter --> Author: 4.4. Show "Translation failed"
end

GetNovel --> Router: 5. Cache result
deactivate GetNovel

Router --> TranslatorPanel: 6. Forward cache
deactivate Router

alt Cache exists
    TranslatorPanel --> TextChapter: 6.1.1. Load cached translation
    TextChapter --> Author: 6.1.2. Load cached translation
else No cache
    TranslatorPanel --> TextChapter: 6.2.1. Empty preview
    TextChapter --> Author: 6.2.2. Empty preview
end

Author -> TranslatorPanel: 7. Click AI Translate

opt Empty content
    TranslatorPanel --> TextChapter: 7.1. Alert no content
    TextChapter --> Author: 7.2. Alert no content
end

TranslatorPanel -> Router: 8. Send text for translation
activate Router

Router -> FastNovel: 9. POST /fast-novel-translation
activate FastNovel

opt AI / Network Error
    FastNovel --> Router: 9.1. Timeout / failure
    Router --> TranslatorPanel: 9.2. HTTP error
    TranslatorPanel --> TextChapter: 9.3. Show error
    TextChapter --> Author: 9.4. Show error
end

ref over Router: 64.b.i. Subsequence - AI Translation (Ollama Agent)

FastNovel --> Router : 10. translated_text
deactivate FastNovel

Router --> TranslatorPanel: 11. Forward result
deactivate Router

TranslatorPanel --> Author: 12. Show translated text + score

opt Manual edit
    Author -> TranslatorPanel: 12.1. Edit translated text
end

Author -> TranslatorPanel: 13. Click Apply

TranslatorPanel -> Router: 14. Save translation
activate Router

Router -> SaveNovel: 15. POST /save-novel-translation
activate SaveNovel

opt Save error
    SaveNovel --> Router: 15.1. DB error
    Router --> TranslatorPanel: 15.2. HTTP error
    TranslatorPanel --> TextChapter: 15.3. Show "Save failed"
    TextChapter --> Author: 15.4. Show "Save failed"
end

SaveNovel --> Router: 16. Success
deactivate SaveNovel

Router --> TranslatorPanel: 17. Confirm
deactivate Router
TranslatorPanel --> TextChapter: 18. Confirm
deactivate TranslatorPanel
TextChapter --> Author: 19. Update chapter content
deactivate TextChapter
deactivate Author