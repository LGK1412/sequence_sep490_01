bottomparticipants

actor User
boundary "Home / Recommend Section" as UI
boundary Router
control MangaController
control MangaService
entity ":HistoryModel" as HistoryModel
entity ":RatingModel" as RatingModel
entity ":MangaModel" as MangaModel
database MongoDB

User -> UI: 1. Open recommended stories
activate User
activate UI

UI -> Router: 2. GET /api/manga/recomment/user/{userId}
activate Router

Router -> MangaController: 3. getRecommendStory(userId)
activate MangaController

MangaController -> MangaController: 4. Check userId
activate MangaController
space
deactivate MangaController

opt User ID mismatch
  MangaController --> Router: 4.1. BadRequestException
  Router --> UI: 4.2. HTTP error
  UI --> User: 4.3. Show error
end

MangaController -> MangaService: 5. getRecommendStory(userObjectId)
activate MangaService

MangaService -> HistoryModel: 6. find reading histories (limit 20)
activate HistoryModel
HistoryModel -> MongoDB: 7. query histories
activate MongoDB
MongoDB --> HistoryModel: 8. histories
deactivate MongoDB
HistoryModel --> MangaService: 9. return histories
deactivate HistoryModel

MangaService -> MangaService: 10. Check histories
activate MangaService
space
deactivate MangaService

opt No reading history
  MangaService -> MangaModel: 10.1. getAllManga(1,10)
  activate MangaModel
  MangaModel -> MongoDB: 10.2. aggregate top manga
  activate MongoDB
  MongoDB --> MangaModel: 10.3. result
  deactivate MongoDB
  MangaModel --> MangaService: 10.4. data
  deactivate MangaModel
end

MangaService -> RatingModel: 11. find rating >= 4
activate RatingModel
RatingModel -> MongoDB: 12. query ratings
activate MongoDB
MongoDB --> RatingModel: 13. ratings
deactivate MongoDB
RatingModel --> MangaService: 14. return liked manga
deactivate RatingModel

MangaService -> MangaModel: 15. find genres & styles of liked manga
activate MangaModel
MangaModel -> MongoDB: 16. query manga
activate MongoDB
MongoDB --> MangaModel: 17. manga list
deactivate MongoDB
MangaModel --> MangaService: 18. genres & styles
deactivate MangaModel

MangaService -> MangaModel: 19. aggregate recommend pipeline
activate MangaModel
MangaModel -> MongoDB: 20. aggregate (filter, lookup, sort, facet)
activate MongoDB
MongoDB --> MangaModel: 21. recommend result
deactivate MongoDB
MangaModel --> MangaService: 22. { data, total }
deactivate MangaModel

MangaService --> MangaController: 23. return recommended stories
deactivate MangaService

MangaController --> Router: 24. HTTP response
deactivate MangaController

Router --> UI: 25. Response data
deactivate Router
UI --> User: 26. Show recommended manga
deactivate UI
deactivate User