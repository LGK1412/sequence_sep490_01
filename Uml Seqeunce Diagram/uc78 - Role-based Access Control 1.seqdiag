bottomparticipants

actor Admin
boundary "User Management UI" as UI
boundary Router
control AccessTokenGuard
control RolesGuard
control UsersController
control UsersService
control AuditLogsService
entity ":UsersModel" as UsersModel
entity ":AuditLogsModel" as AuditLogsModel
database MongoDB

Admin -> UI: 1. Open "Edit Staff" dialog + choose status (ban/mute/normal)
activate Admin
activate UI

opt Client validation failed
  UI --> Admin: 1.1 Show inline error
end

UI -> Router: 2. POST /api/user/update-status
activate Router

Router -> AccessTokenGuard: 3. canActivate(request)
activate AccessTokenGuard

AccessTokenGuard -> AccessTokenGuard: 4. Validate token
activate AccessTokenGuard
space
deactivate AccessTokenGuard

opt Token invalid
  AccessTokenGuard --> Router: 4.1 Deny
  Router --> UI: 4.2 401 Unauthorized
  UI --> Admin: 4.3 Show error message
end

AccessTokenGuard --> Router: 5. Allow
deactivate AccessTokenGuard

Router -> RolesGuard: 6. checkRole(ADMIN)
activate RolesGuard

RolesGuard -> RolesGuard: 7. Check admin role
activate RolesGuard
space
deactivate RolesGuard

opt Role invalid
  RolesGuard --> Router: 7.1 Deny
  Router --> UI: 7.2 403 Forbidden
  UI --> Admin: 7.3 Show error message
end

RolesGuard --> Router: 8. Allow
deactivate RolesGuard

Router -> UsersController: 9. updateStatus(dto, req.user)
activate UsersController

UsersController -> UsersService: 10. adminUpdateStaffStatus(adminId, userId, status)
activate UsersService

UsersService -> UsersService: 11. Validate status
activate UsersService
space
deactivate UsersService

opt Invalid status
  UsersService --> UsersController: 11.1 BadRequestException
  UsersController --> Router: 11.2 400 Bad Request
  Router --> UI: 11.3 Error response
  UI --> Admin: 11.4 Show error message
end

UsersService -> UsersModel: 12. findById(userId)
activate UsersModel
UsersModel -> MongoDB: 13. query user by _id
activate MongoDB
MongoDB --> UsersModel: 14. user | null
deactivate MongoDB
UsersModel --> UsersService: 15. user entity
deactivate UsersModel

UsersService -> UsersService: 16. Check target user
activate UsersService
space
deactivate UsersService

opt Target not found / Target is not staff
  UsersService --> UsersController: 16.1 NotFoundException
  UsersController --> Router: 16.2 404 Not Found
  Router --> UI: 16.3 Error response
  UI --> Admin: 16.4 Show error message
end

UsersService -> UsersModel: 17. updateOne({_id}, {$set:{status}})
activate UsersModel
UsersModel -> MongoDB: 18. update status
activate MongoDB
MongoDB --> UsersModel: 19. update result
deactivate MongoDB
UsersModel --> UsersService: 20. update result
deactivate UsersModel

UsersService -> UsersService: 21. Check update result
activate UsersService
space
deactivate UsersService

opt Update failed
  UsersService --> UsersController: 21.1 BadRequestException
  UsersController --> Router: 21.2 400 Bad Request
  Router --> UI: 21.3 Error response
  UI --> Admin: 21.4 Show error message
end

UsersService -> AuditLogsService: 22. createLog(action=update_status)
activate AuditLogsService
AuditLogsService -> AuditLogsModel: 23. create(auditLog)
activate AuditLogsModel
AuditLogsModel -> MongoDB: 24. insert document
activate MongoDB
MongoDB --> AuditLogsModel: 25. Saved document
deactivate MongoDB
AuditLogsModel --> AuditLogsService: 26. Created audit log
deactivate AuditLogsModel
AuditLogsService --> UsersService: 27. Log created
deactivate AuditLogsService

UsersService --> UsersController: 28. { success:true }
deactivate UsersService

UsersController --> Router: 29. 200 OK response
deactivate UsersController

Router --> UI: 30. Return success response
deactivate Router

UI -> UI: 31. Update table state
activate UI
space
deactivate UI

UI --> Admin: 32. Show success message
deactivate UI
deactivate Admin