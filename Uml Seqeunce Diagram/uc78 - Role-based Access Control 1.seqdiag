bottomparticipants

actor Admin
boundary "User Management UI" as UI
boundary Router
control AccessTokenGuard
control RolesGuard
control UsersController
control UsersService
control AuditLogsService
entity UsersModel
entity AuditLogsModel
database MongoDB

Admin -> UI: 1. Open "Edit Staff" dialog + choose status (ban/mute/normal)
activate Admin
activate UI

opt Client validation failed
  UI --> Admin: 1.1. Show inline error
end

UI -> Router: 2. POST /api/user/update-status
activate Router

Router -> AccessTokenGuard: 3. canActivate(request)
activate AccessTokenGuard

opt Token invalid
  AccessTokenGuard --> Router: 3.1. Deny
  Router --> UI: 3.2. 401 Unauthorized
  UI --> Admin: 3.3. Show error message
end

AccessTokenGuard --> Router: 4. Allow
deactivate AccessTokenGuard

Router -> RolesGuard: 5. checkRole(ADMIN)
activate RolesGuard

opt Role invalid
  RolesGuard --> Router: 5.1. Deny
  Router --> UI: 5.2. 403 Forbidden
  UI --> Admin: 5.3. Show error message
end

RolesGuard --> Router: 6. Allow
deactivate RolesGuard

Router -> UsersController: 7. updateStatus(dto, req.user)
activate UsersController

UsersController -> UsersService: 8. adminUpdateStaffStatus(adminId, userId, status)
activate UsersService

opt Invalid status
  UsersService --> UsersController: 8.1. Throw BadRequestException
  UsersController --> Router: 8.2. 400 Bad Request
  Router --> UI: 8.3. Error response
  UI --> Admin: 8.4. Show error message
end

UsersService -> UsersModel: 9. findById(userId)
activate UsersModel
UsersModel -> MongoDB: 10. query user by _id
activate MongoDB
MongoDB --> UsersModel: 11. user | null
deactivate MongoDB
UsersModel --> UsersService: 12. user entity
deactivate UsersModel

loop Target not found / Target is not staff
  UsersService --> UsersController: 12.1. Throw NotFoundException
  UsersController --> Router: 12.2. 404 Not Found
  Router --> UI: 12.3. Error response
  UI --> Admin: 12.4. Show error message
end

UsersService -> UsersModel: 13. updateOne({_id}, {$set:{status}})
activate UsersModel
UsersModel -> MongoDB: 14. update status
activate MongoDB
MongoDB --> UsersModel: 15. update result
deactivate MongoDB
UsersModel --> UsersService: 16. update result
deactivate UsersModel

opt Update failed
  UsersService --> UsersController: 16.1. Throw BadRequestException
  UsersController --> Router: 16.2. 400 Bad Request
  Router --> UI: 16.3. Error response
  UI --> Admin: 16.4. Show error message
end

UsersService -> AuditLogsService: 17. createLog(action=update_status)
activate AuditLogsService
AuditLogsService -> AuditLogsModel: 18. create(auditLog)
activate AuditLogsModel
AuditLogsModel -> MongoDB: 19. insert document
activate MongoDB
MongoDB --> AuditLogsModel: 20. Saved document
deactivate MongoDB
AuditLogsModel --> AuditLogsService: 21. Created audit log
deactivate AuditLogsModel
AuditLogsService --> UsersService: 22. Log created
deactivate AuditLogsService

UsersService --> UsersController: 23. { success:true }
deactivate UsersService

UsersController --> Router: 24. 200 OK response
deactivate UsersController

Router --> UI: 25. Return success response
deactivate Router

UI -> UI: 26. Update table state
activate UI
space
deactivate UI

UI --> Admin: 27. Show success message
deactivate UI
deactivate Admin

@enduml