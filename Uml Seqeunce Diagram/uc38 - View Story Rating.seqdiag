bottomparticipants

actor User
boundary "Manga Rating Section (UI)" as UI
boundary Router
control RatingController
control RatingService
entity RatingModel
database MongoDB

User -> UI: 1. Open manga reviews
activate User
activate UI

UI -> Router: 2. GET /rating/all?mangaId
activate Router

Router -> RatingController: 3. all(mangaId)
activate RatingController

RatingController -> RatingController: 4. Validate mangaId
activate RatingController
space
deactivate RatingController

loop Invalid mangaId / Invalid mangaId type
    RatingController --> Router: 4.1. 400 Bad Request
    Router --> UI: 4.2. HTTP response
    UI --> User: 4.3. Show error message
end

RatingController -> RatingService: 5. listAllByManga(mangaId)

activate RatingService
RatingService -> RatingModel: 6. Find ratings
activate RatingModel

RatingModel -> MongoDB: 7. Find ratings
activate MongoDB
MongoDB --> RatingModel: 8. Return ratings
deactivate MongoDB

RatingModel --> RatingService: 9. Ratings list
deactivate RatingModel

RatingService --> RatingController: 10. Return list
deactivate RatingService

RatingController --> Router: 11. HTTP response
deactivate RatingController
Router --> UI: 12. Render ratings list
deactivate Router
UI --> User: 13. Show reviews
deactivate UI
deactivate User