bottomparticipants

actor User
boundary "Home / Discover Page" as UI
boundary Router
control MangaController
control MangaService
entity ":MangaModel" as MangaModel
database MongoDB

User -> UI: 1. Click "Random story"
activate User
activate UI

UI -> Router: 2. GET /api/manga/random
activate Router

Router -> MangaController: 3. getRandom()
activate MangaController

MangaController -> MangaService: 4. getRandomManga()
activate MangaService

MangaService -> MangaModel: 5. aggregate(random pipeline)
activate MangaModel
MangaModel -> MongoDB: 6. aggregate (match, lookup chapters, sample)
activate MongoDB
MongoDB --> MangaModel: 7. random manga
deactivate MongoDB
MangaModel --> MangaService: 8. aggregation result
deactivate MangaModel

MangaService -> MangaService: 9. Check result
activate MangaService
space
deactivate MangaService

opt No story found
  MangaService --> MangaController: 9.1. null
  MangaController --> Router: 9.2. NotFoundException
  Router --> UI: 9.3. Show error
  UI --> User: 9.4. Show error
end

MangaService --> MangaController: 10. return random manga (_id, title)
deactivate MangaService

MangaController --> Router: 11. HTTP response
deactivate MangaController

Router --> UI: 12. Response data
deactivate Router
UI --> User: 13. Show random story
deactivate UI
deactivate User