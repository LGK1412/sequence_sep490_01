bottomparticipants

actor User
control "Other Service" as System
control "NotificationService" as NotiService
entity ":MotificationModel" as MotificationModel
database MongoDB
control "Firebase Admin" as Firebase

User -> System: 1. sendNotification(notification)
activate User
activate System
System -> NotiService: 2. createNotification(noti)
activate NotiService

NotiService -> MotificationModel: 3. insert notification (noti.save)
activate MotificationModel
MotificationModel -> MongoDB: 4. insert
activate MongoDB
MongoDB --> MotificationModel: 5. saved
deactivate MongoDB
MotificationModel --> NotiService: 6. saved
deactivate MotificationModel

NotiService -> NotiService: 7. Get device id
activate NotiService
space
deactivate NotiService

opt No tokens
  NotiService --> System: 7.1 {successTokens:[], failedTokens:[]}
  System --> User: 7.2 return empty result
end

NotiService -> Firebase: 8. sendEachForMulticast(tokens,title,body)
activate Firebase
Firebase --> NotiService: 9. successCount/failureCount + per-token results
deactivate Firebase
NotiService -> NotiService: 10. Build successTokens/failedTokens
activate NotiService
space
deactivate NotiService
NotiService --> System: 11. Return delivery result
deactivate NotiService
System --> User: 12. return send result
deactivate System
deactivate User