@startuml
skinparam {
    ActorBackgroundColor #FFFFFF
    BoundaryBackgroundColor #FFFFFF
    ControlBackgroundColor #FFFFFF
    EntityBackgroundColor #FFFFFF
    DatabaseBackgroundColor #FFFFFF

    ActorBorderColor black
    BoundaryBorderColor black
    ControlBorderColor black
    EntityBorderColor black
    DatabaseBorderColor black
}

actor User
boundary "Forgot Password UI" as UI
boundary Router
control AuthController
control AuthService
control UserService
control JwtService
control MailerService
entity UserModel
database MongoDB

User -> UI: 1. Submit forgot password (email)
activate User
activate UI

UI -> Router: 2. POST /auth/forgot-password
activate Router

Router -> AuthController: 3. sendVerificationForgotPassword(email)
activate AuthController

AuthController -> AuthService: 4. sendVerificationForgotPassword(email)
activate AuthService

alt Email invalid
    AuthService --> AuthController: 4.1. BadRequestException
    AuthController --> Router: 4.2. Return error
    Router --> UI: 4.3. Return error
    UI --> User: 4.4. Show error
end

AuthService -> UserService: 5. findByEmail(email)
activate UserService
UserService -> UserModel: 6. findOne(email)
activate UserModel
UserModel -> MongoDB: 7. query user
activate MongoDB
MongoDB --> UserModel: 8. user / null
deactivate MongoDB
UserModel --> UserService: 9. user
deactivate UserModel
UserService --> AuthService: 10. user
deactivate UserService

alt User not exist / banned / google / not verified
    AuthService --> AuthController: 10.1. BadRequestException
    AuthController --> Router: 10.2. Return error
    Router --> UI: 10.3. Return error
    UI --> User: 10.4. Show error
end

AuthService -> JwtService: 11. sign({email, action}, 15m)
activate JwtService
JwtService --> AuthService: 12. token
deactivate JwtService

AuthService -> MailerService: 13. sendMail(verifyForgotPassword)
activate MailerService
MailerService --> AuthService: 14. mail sent
deactivate MailerService

alt Send mail failed
    AuthService --> AuthController: 14.1. InternalServerErrorException
    AuthController --> Router: 14.2. Return error
    Router --> UI: 14.3. Return error
    UI --> User: 14.4. Show error
end

AuthService -> UserService: 15. updateVerifyForgotPasswordCode(code, email)
activate UserService
UserService -> UserModel: 16. Update user
activate UserModel
UserModel -> MongoDB: 17. Update document
activate MongoDB
MongoDB --> UserModel: 18. Return result
deactivate MongoDB
UserModel --> UserService: 19. Return result
deactivate UserModel
UserService --> AuthService: 20. Return result
deactivate UserService

alt Update failed
    AuthService --> AuthController: 20.1. InternalServerErrorException
    AuthController --> Router: 20.2. Return error
    Router --> UI: 20.3. Return error
    UI --> User: 20.4. Show error
end

AuthService --> AuthController: 21. Return success response
deactivate AuthService

AuthController --> Router: 22. Return HTTP response
deactivate AuthController
Router --> UI: 23. Show success message
deactivate Router
UI --> User: 24. Verification email sent
deactivate UI
deactivate User
@enduml
