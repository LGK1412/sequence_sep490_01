@startuml
skinparam {
  ActorBackgroundColor #FFFFFF
  BoundaryBackgroundColor #FFFFFF
  ControlBackgroundColor #FFFFFF
  EntityBackgroundColor #FFFFFF
  DatabaseBackgroundColor #FFFFFF
  ActorBorderColor black
  BoundaryBorderColor black
  ControlBorderColor black
  EntityBorderColor black
  DatabaseBorderColor black
}

actor User
boundary "Notification Page" as UI
boundary Router
control NotificationController as NC
control NotificationService as NS
database MongoDB

User -> UI: 1. Click Delete
activate User
activate UI

UI -> Router: 2. DELETE /api/notification/delete-noti/{id}
activate Router

Router -> NC: 3. deleteNoti(id, req)
activate NC
NC -> NC: 4. Guard check (AccessToken + Roles)

NC -> NS: 5. deleteNoti(id, payload)
activate NS

NS -> NS: 6. checkUser(payload.user_id)
alt 7. User invalid / banned / no permission
  NS --> NC: 7.1 400 error
  NC --> Router: 7.2 HTTP error
  Router --> UI: 7.3 Show error
else 8. OK
  NS -> MongoDB: 8.1 findOneAndDelete({_id:id, receiver_id:payload.user_id})
  activate MongoDB
  MongoDB --> NS: 8.2 deletedDoc / null
  deactivate MongoDB

  NS --> NC: 9. return deletedDoc (may be null)
  NC --> Router: 10. HTTP 200
  Router --> UI: 11. Remove item / refresh list
end

deactivate NS
deactivate NC
deactivate Router
deactivate UI
deactivate User
@enduml