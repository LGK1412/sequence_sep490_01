@startuml
skinparam {
  ActorBackgroundColor #FFFFFF
  BoundaryBackgroundColor #FFFFFF
  ControlBackgroundColor #FFFFFF
  EntityBackgroundColor #FFFFFF
  DatabaseBackgroundColor #FFFFFF
  ActorBorderColor black
  BoundaryBorderColor black
  ControlBorderColor black
  EntityBorderColor black
  DatabaseBorderColor black
}

actor User
boundary "Notification Page" as UI
boundary Router
control NotificationController as NC
control NotificationService as NS
database MongoDB

User -> UI: 1. Click "Mark all as read"
activate User
activate UI

UI -> Router: 2. PATCH /api/notification/mark-all-noti-as-read
activate Router

Router -> NC: 3. markAllNotiAsRead(req)
activate NC
NC -> NC: 4. Guard check (AccessToken + Roles)

NC -> NS: 5. markAllAsRead(payload)
activate NS

NS -> NS: 6. checkUser(payload.user_id)
alt 7. User invalid / banned / no permission
  NS --> NC: 7.1 400 error
  NC --> Router: 7.2 HTTP error
  Router --> UI: 7.3 Show error
else 8. OK
  NS -> MongoDB: 8.1 updateMany({receiver_id, is_read:false}, {$set:{is_read:true}})
  activate MongoDB
  MongoDB --> NS: 8.2 update result
  deactivate MongoDB

  NS --> NC: 8.3 return result
  NC --> Router: 8.4 HTTP 200
  Router --> UI: 8.5 Update UI
end

deactivate NS
deactivate NC
deactivate Router
deactivate UI
deactivate User
@enduml