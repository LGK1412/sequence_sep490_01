@startuml
skinparam {
  ActorBackgroundColor #FFFFFF
  BoundaryBackgroundColor #FFFFFF
  ControlBackgroundColor #FFFFFF
  EntityBackgroundColor #FFFFFF
  DatabaseBackgroundColor #FFFFFF
  ActorBorderColor black
  BoundaryBorderColor black
  ControlBorderColor black
  EntityBorderColor black
  DatabaseBorderColor black
}

actor User
boundary "Home Page" as UI
boundary Router
control MangaController as MC
control MangaService as MS
database MongoDB

User -> UI: 1. Open home
activate User
activate UI

UI -> Router: 2. GET /api/manga/recomment/user/{userId}
activate Router

Router -> MC: 3. getRecommendStory(userId, req)
activate MC
MC -> MC: 4. Guard check (AccessToken + Roles)

MC -> MC: 5. Compare param userId vs token userId
alt 6. User ID mismatch
  MC --> Router: 6.1 400 BadRequest
  Router --> UI: 6.2 Do not show recommendations
else 7. OK
  MC -> MS: 7.1 getRecommendStory(userId)
  activate MS

  MS -> MongoDB: 7.2 read history / ratings / genres+styles
  activate MongoDB
  MongoDB --> MS: 7.3 data for scoring (may be empty)
  deactivate MongoDB

  alt 8. Not enough data (fallback)
    MS -> MS: 8.1 getAllManga(1,10)
    MS -> MongoDB: 8.2 aggregate fallback
    activate MongoDB
    MongoDB --> MS: 8.3 fallback list
    deactivate MongoDB
  else 9. Recommend pipeline
    MS -> MongoDB: 9.1 aggregate recommendation
    activate MongoDB
    MongoDB --> MS: 9.2 recommended list
    deactivate MongoDB
  end

  MS --> MC: 10. return list
  deactivate MS
  MC --> Router: 11. HTTP 200
  Router --> UI: 12. Render recommendations
end

deactivate MC
deactivate Router
deactivate UI
deactivate User
@enduml