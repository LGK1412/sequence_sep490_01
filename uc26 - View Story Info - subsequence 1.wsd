@startuml
skinparam {
  ActorBackgroundColor #FFFFFF
  BoundaryBackgroundColor #FFFFFF
  ControlBackgroundColor #FFFFFF
  EntityBackgroundColor #FFFFFF
  DatabaseBackgroundColor #FFFFFF
  ActorBorderColor black
  BoundaryBorderColor black
  ControlBorderColor black
  EntityBorderColor black
  DatabaseBorderColor black
}

title Subsequence - View Story Info

control MangaService
entity ChapterModel
entity ChapterPurchaseModel
entity RatingModel
database MongoDB

MangaService -> ChapterModel: 9. find published chapters
activate ChapterModel
activate MangaService
ChapterModel -> MongoDB: 10. query chapters
activate MongoDB
MongoDB --> ChapterModel: 11. chapter list
deactivate MongoDB
ChapterModel --> MangaService: 12. return chapters
deactivate ChapterModel

opt User logged in
  MangaService -> ChapterPurchaseModel: 12.1. find purchased chapters
  activate ChapterPurchaseModel
  ChapterPurchaseModel -> MongoDB: 12.2. query purchases
  activate MongoDB
  MongoDB --> ChapterPurchaseModel: 12.3. purchased chapters
  deactivate MongoDB
  ChapterPurchaseModel --> MangaService: 12.4. return purchases
  deactivate ChapterPurchaseModel
end

MangaService -> MangaService: 13. map chapters (locked / purchased)
activate MangaService
MangaService -> RatingModel: 14. aggregate rating summary
deactivate MangaService
activate RatingModel
RatingModel -> MongoDB: 15. aggregate ratings
activate MongoDB
MongoDB --> RatingModel: 16. rating summary
deactivate MongoDB
RatingModel --> MangaService: 17. return summary
deactivate RatingModel
deactivate MangaService

@enduml
