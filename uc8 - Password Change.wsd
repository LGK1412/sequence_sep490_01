@startuml
skinparam {
    ActorBackgroundColor #FFFFFF
    BoundaryBackgroundColor #FFFFFF
    ControlBackgroundColor #FFFFFF
    EntityBackgroundColor #FFFFFF
    DatabaseBackgroundColor #FFFFFF

    ActorBorderColor black
    BoundaryBorderColor black
    ControlBorderColor black
    EntityBorderColor black
    DatabaseBorderColor black
}

actor User
boundary "Change Password UI" as UI
boundary Router
control AuthController
control AuthService
control JwtService
control UserService
entity UserModel
boundary HashUtils
database MongoDB

User -> UI: 1. Submit new password
activate User
activate UI

UI -> Router: 2. POST /auth/change-password
activate Router

Router -> AuthController: 3. changePassword(dto, req)
activate AuthController

AuthController -> AuthService: 4. changePassword(password, access_token)
activate AuthService

opt Missing token
    AuthService --> AuthController: 4.1. BadRequestException
    AuthController --> Router: 4.2. HTTP response
    Router --> UI: 4.3. Show error
    UI --> User: 4.4. Show error
end

AuthService -> JwtService: 5. verify(token)
activate JwtService

loop Invalid / expired token
    JwtService --> AuthService: 5.1. error
    AuthService --> AuthController: 5.2. BadRequestException
    AuthController --> Router: 5.3. HTTP response
    Router --> UI: 5.4. Show error
    UI --> User: 5.5. Show error
end

JwtService --> AuthService: 6. payload(email)
deactivate JwtService

AuthService -> UserService: 7. findByEmail(email)
activate UserService
UserService -> UserModel: 8. findOne(email)
activate UserModel
UserModel -> MongoDB: 9. query user
activate MongoDB
MongoDB --> UserModel: 10. user / null
deactivate MongoDB
UserModel --> UserService: 11. user
deactivate UserModel
UserService --> AuthService: 12. user
deactivate UserService

loop User invalid / banned / google / not verified
    AuthService --> AuthController: 12.1. BadRequestException
    AuthController --> Router: 12.2. HTTP response
    Router --> UI: 12.3. Show error
    UI --> User: 12.4. Show error
end

AuthService -> HashUtils: 13. comparePassword(new, old)
activate HashUtils
HashUtils --> AuthService: 14. result
deactivate HashUtils

opt Same password
    AuthService --> AuthController: 13.1. BadRequestException
    AuthController --> Router: 13.2. HTTP response
    Router --> UI: 13.3. Show error
    UI --> User: 13.4. Show error
end

AuthService -> HashUtils: 14. hashPassword(newPassword)
activate HashUtils
HashUtils --> AuthService: 15. result
deactivate HashUtils

AuthService -> UserService: 16. changePassword(newPassword, email)
activate UserService
UserService -> UserModel: 17. update password
activate UserModel
UserModel -> MongoDB: 18. update document
activate MongoDB
MongoDB --> UserModel: 19. return result
deactivate MongoDB
UserModel --> UserService: 20. return result
deactivate UserModel
UserService --> AuthService: 21. return result
deactivate UserService

opt Update failed
    AuthService --> AuthController: 21.1. BadRequestException
    AuthController --> Router: 21.2. HTTP response
    Router --> UI: 21.3. Show error
    UI --> User: 21.4. Show error
end

AuthService --> AuthController: 22. success response
deactivate AuthService

AuthController --> Router: 23. HTTP response
deactivate AuthController
Router --> UI: 24. Show success message
deactivate Router
UI --> User: 25. Password updated successfully
deactivate UI
deactivate User
@enduml
