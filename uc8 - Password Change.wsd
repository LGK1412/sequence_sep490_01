@startuml
skinparam {
    ActorBackgroundColor #FFFFFF
    BoundaryBackgroundColor #FFFFFF
    ControlBackgroundColor #FFFFFF
    EntityBackgroundColor #FFFFFF
    DatabaseBackgroundColor #FFFFFF

    ActorBorderColor black
    BoundaryBorderColor black
    ControlBorderColor black
    EntityBorderColor black
    DatabaseBorderColor black
}

actor User
boundary "Change Password UI" as UI
boundary Router
control AuthController
control AuthService
control JwtService
control UserService
entity UserModel
boundary HashUtil
database MongoDB

User -> UI: 1. Submit new password
activate User
activate UI

UI -> Router: 2. POST /auth/change-password
activate Router

Router -> AuthController: 3. changePassword(dto, req)
activate AuthController

AuthController -> AuthService: 4. changePassword(password, access_token)
activate AuthService

opt Missing token
    AuthService --> AuthController: 4.1. BadRequestException
    AuthController --> Router: 4.2. HTTP response
    Router --> UI: 4.3. Show error
    UI --> User: 4.4. Show error
end

AuthService -> JwtService: 5. verify(token)
activate JwtService

loop Invalid / expired token
    JwtService --> AuthService: 5.1. error
    AuthService --> AuthController: 5.2. BadRequestException
    AuthController --> Router: 5.3. HTTP response
    Router --> UI: 5.4. Show error
    UI --> User: 5.5. Show error
end

JwtService --> AuthService: 6. payload(email)
deactivate JwtService

ref over AuthService, UserService, UserModel, MongoDB
    7. Subsequence - Find user for Password Recovery
end ref

loop User invalid / banned / google / not verified
    AuthService --> AuthController: 7.1. BadRequestException
    AuthController --> Router: 7.2. HTTP response
    Router --> UI: 7.3. Show error
    UI --> User: 7.4. Show error
end

AuthService -> HashUtil: 8. comparePassword(new, old)
activate HashUtil
HashUtil --> AuthService: 9. result
deactivate HashUtil

opt Same password
    AuthService --> AuthController: 9.1. BadRequestException
    AuthController --> Router: 9.2. HTTP response
    Router --> UI: 9.3. Show error
    UI --> User: 9.4. Show error
end

ref over AuthService, UserService, HashUtil, UserModel, MongoDB
    10. Subsequence - Update new password
end ref

opt Update failed
    AuthService --> AuthController: 11.1. BadRequestException
    AuthController --> Router: 11.2. HTTP response
    Router --> UI: 11.3. Show error
    UI --> User: 11.4. Show error
end

AuthService --> AuthController: 12. success response
deactivate AuthService

AuthController --> Router: 13. HTTP response
deactivate AuthController
Router --> UI: 14. Show success message
deactivate Router
UI --> User: 15. Password updated successfully
deactivate UI
deactivate User
@enduml
