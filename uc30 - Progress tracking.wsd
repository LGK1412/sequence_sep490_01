@startuml
skinparam {
    ActorBackgroundColor #FFFFFF
    BoundaryBackgroundColor #FFFFFF
    ControlBackgroundColor #FFFFFF
    EntityBackgroundColor #FFFFFF
    DatabaseBackgroundColor #FFFFFF

    ActorBorderColor black
    BoundaryBorderColor black
    ControlBorderColor black
    EntityBorderColor black
    DatabaseBorderColor black
}

actor User
boundary "Chapter Detail Page (UI)" as UI
boundary Router
control ChapterController
control ChapterService
entity ProgressModel
entity ChapterModel
entity HistoryModel
database MongoDB

User -> UI: 1. Read & scroll chapter
activate User
activate UI
UI -> Router: 2. POST progress
activate Router
Router -> ChapterController: 3. createChapterProgress()

activate ChapterController
ChapterController -> ChapterController: 4. Parse params & convert ObjectId
activate ChapterController
ChapterController -> ChapterService: 5. createChapterProgress(user_id, chapter_id, percent)
deactivate ChapterController
activate ChapterService

ref over ChapterService, ProgressModel, ChapterModel, MongoDB
    6. Subsequence - Progress tracking
end ref

opt Chapter has no manga
    ChapterService --> ChapterController: 6.1. Return chapterProgress
    ChapterController --> Router: 6.2. HTTP response
    Router --> UI: 6.3. Progress saved
    UI --> User: 6.4. Progress saved
end
' 7. Update reading history
ChapterService -> HistoryModel:.7.  Update reading history
activate HistoryModel
HistoryModel -> MongoDB: 8. Upsert history record
activate MongoDB
MongoDB --> HistoryModel: 9. Updated history
deactivate MongoDB
HistoryModel --> ChapterService: 10. History result
deactivate HistoryModel

ChapterService --> ChapterController: 11. Return chapterProgress
deactivate ChapterService
ChapterController --> Router: 12. HTTP response
deactivate ChapterController
Router --> UI: 13. Progress saved
deactivate Router
UI --> User: 14. Progress saved
deactivate UI
deactivate User
@enduml
