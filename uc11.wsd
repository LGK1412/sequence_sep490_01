@startuml
skinparam {
  ActorBackgroundColor #FFFFFF
  BoundaryBackgroundColor #FFFFFF
  ControlBackgroundColor #FFFFFF
  EntityBackgroundColor #FFFFFF
  DatabaseBackgroundColor #FFFFFF
  ActorBorderColor black
  BoundaryBorderColor black
  ControlBorderColor black
  EntityBorderColor black
  DatabaseBorderColor black
}

actor User
boundary "Public Profile Page" as UI
boundary Router
control UserController
control UserService
database MongoDB

User -> UI: 1. Click other user's profile
activate User
activate UI

UI -> Router: 2. GET /api/user/public/{id}
activate Router

Router -> UserController: 3. getPublicUser(id)
activate UserController
UserController -> UserService: 4. getPublicUserById(id)
activate UserService

UserService -> UserService: 5. Validate ObjectId

alt 6. Invalid id
  UserService --> UserController: 6.1 NotFoundException\n(User does not exist)
else 7. OK
  UserService -> MongoDB: 7.1 findById().select(username,avatar,bio,role)
  activate MongoDB
  MongoDB --> UserService: 7.2 user / null
  deactivate MongoDB

  alt 8. User is null
    UserService --> UserController: 8.1 NotFoundException\n(User does not exist)
  else 9. Found
    UserService --> UserController: 9.1 Return public profile
  end
end

deactivate UserService
UserController --> Router: 10. HTTP response
deactivate UserController

Router --> UI: 11. Render profile / show error
deactivate Router

deactivate UI
deactivate User
@enduml