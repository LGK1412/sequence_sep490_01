@startuml
skinparam {
    ActorBackgroundColor #FFFFFF
    BoundaryBackgroundColor #FFFFFF
    ControlBackgroundColor #FFFFFF
    EntityBackgroundColor #FFFFFF
    DatabaseBackgroundColor #FFFFFF

    ActorBorderColor black
    BoundaryBorderColor black
    ControlBorderColor black
    EntityBorderColor black
    DatabaseBorderColor black
}

actor User
boundary "Verify Email Page" as UI
boundary Router
control AuthController
control AuthService
control UserService
entity UserModel
database MongoDB

User -> UI: 1. Click verification link in email
activate User
activate UI

UI -> Router: 2. POST /api/auth/verify-email (code)
activate Router

Router -> AuthController: 3. verificationEmail(code)
activate AuthController

AuthController -> AuthService: 4. verificationEmail(token)

activate AuthService

loop Missing token / Invalid or expired token / Invalid token payload
    AuthService --> AuthController: 4.1.1. Throw BadRequestException
    AuthController --> Router: 4.1.2. HTTP 400 response
    Router --> UI: 4.1.3. Show error
    UI --> User: 4.1.4. Missing verification token
end

ref over AuthService, UserService, UserModel, MongoDB
    5. Subsequence - Find User for Email Verification
end ref

loop User not found or banned / User already verified / Code mismatch
    AuthService --> AuthController: 5.1. Throw BadRequestException
    AuthController --> Router: 5.2. HTTP 400 response
    Router --> UI: 5.3. Show error
    UI --> User: 5.4. User invalid
end

ref over AuthService, UserService, UserModel, MongoDB
    6. Subsequence - Update Verified Status
end ref

opt Update verification failed
    AuthService --> AuthController: 7.1. Throw BadRequestException
    AuthController --> Router: 7.2. HTTP 400 response
    Router --> UI: 7.3. Show error
    UI --> User: 7.4. Verification failed
end

AuthService --> AuthController: 8. Return success message
deactivate AuthService

AuthController --> Router: 9. HTTP 200 response
deactivate AuthController

Router --> UI: 10. Verification success
deactivate Router

UI --> User: 11. Redirect to login page
deactivate UI
deactivate User
@enduml