@startuml
skinparam {
    ActorBackgroundColor #FFFFFF
    BoundaryBackgroundColor #FFFFFF
    ControlBackgroundColor #FFFFFF
    EntityBackgroundColor #FFFFFF
    DatabaseBackgroundColor #FFFFFF

    ActorBorderColor black
    BoundaryBorderColor black
    ControlBorderColor black
    EntityBorderColor black
    DatabaseBorderColor black
}

actor Author
boundary "Manage Manga UI" as UI
boundary Router
control MangaController
control MangaService
entity MangaModel
database MongoDB

Author -> UI: 1. Click Toggle Delete / Restore
activate Author
activate UI

UI -> Router: 2. POST /{mangaId}/toggle-delete
activate Router

Router -> MangaController: 3. toggleDelete(mangaId, req)
activate MangaController

alt Token Invalid
    MangaController --> Router: 3.1.1. 401 Unauthorized
    Router --> UI: 3.1.2. Show error
    UI --> Author: 3.1.3. Error message
else Role Valid
   MangaController --> Router: 3.2.1 401 Unauthorized
    Router --> UI: 3.2.2 Show error
    UI --> Author: 3.2.3 Error message
end

MangaController -> MangaService: 4. toggleDelete(mangaId, authorId)
activate MangaService

opt Invalid mangaId
    MangaService --> MangaController: 4.1 BadRequestException
    MangaController --> Router: 4.2 Error response
    Router --> UI: 4.3 Show error
    UI --> Author: 4.4 Error message
end

MangaService -> MangaModel: 5. findOne({_id, authorId})
activate MangaModel
MangaModel -> MongoDB: 6. query manga
activate MongoDB
MongoDB --> MangaModel: 7. manga / null
deactivate MongoDB
MangaModel --> MangaService: 8. result
deactivate MangaModel

opt Manga not exist or not owned
    MangaService --> MangaController: 8.1 BadRequestException
    MangaController --> Router: 8.2 Error response
    Router --> UI: 8.3 Show error
    UI --> Author: 8.4 Error message
end

MangaService -> MangaService: 9. toggle isDeleted flag
activate MangaService

MangaService -> MangaModel: 10. updateOne({_id, authorId}, isDeleted)
deactivate MangaService
activate MangaModel
MangaModel -> MongoDB: 11. update document
activate MongoDB
MongoDB --> MangaModel: 12. update success
deactivate MongoDB
MangaModel --> MangaService: 13. updated manga
deactivate MangaModel

MangaService -> MangaModel: 14. findById(id)
activate MangaModel
MangaModel -> MongoDB: 15. query updated manga
activate MongoDB
MongoDB --> MangaModel: 16. manga document
deactivate MongoDB
MangaModel --> MangaService: 17. manga
deactivate MangaModel

MangaService --> MangaController: 18. updated manga
deactivate MangaService

MangaController --> Router: 19. HTTP response
deactivate MangaController
Router --> UI: 20. Update manga status
deactivate Router
UI --> Author: 21. See delete/restore result
deactivate UI
deactivate Author
@enduml
