@startuml
skinparam {
    ActorBackgroundColor #FFFFFF
    BoundaryBackgroundColor #FFFFFF
    ControlBackgroundColor #FFFFFF
    EntityBackgroundColor #FFFFFF
    DatabaseBackgroundColor #FFFFFF

    ActorBorderColor black
    BoundaryBorderColor black
    ControlBorderColor black
    EntityBorderColor black
    DatabaseBorderColor black
}

title Subsequence - Find User for Email Verification

control AuthService
control UserService
entity UserModel
database MongoDB

AuthService -> UserService: 1. findByEmail(email)
activate AuthService
activate UserService
UserService -> UserModel: 2. findOne({ email })
activate UserModel
UserModel -> MongoDB: 3. findOne({ email })
activate MongoDB
MongoDB --> UserModel: 4. User data
deactivate MongoDB
UserModel --> UserService: 5. Result
deactivate UserModel
UserService --> AuthService: 6. Result
deactivate UserService
deactivate AuthService

@enduml