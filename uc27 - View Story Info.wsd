@startuml
skinparam {
  ActorBackgroundColor #FFFFFF
  BoundaryBackgroundColor #FFFFFF
  ControlBackgroundColor #FFFFFF
  EntityBackgroundColor #FFFFFF
  DatabaseBackgroundColor #FFFFFF
  ActorBorderColor black
  BoundaryBorderColor black
  ControlBorderColor black
  EntityBorderColor black
  DatabaseBorderColor black
}

actor User
boundary "Manga Detail Page" as UI
boundary Router
control MangaController
control MangaService
entity MangaModel
entity ChapterModel
entity ChapterPurchaseModel
entity RatingModel
database MongoDB

User -> UI: 1. Open manga detail
activate User
activate UI

UI -> Router: 2. GET /api/manga/detail/{id}
activate Router

Router -> MangaController: 3. getMangaDetail(id)
activate MangaController

MangaController -> MangaService: 4. findMangaDetail(mangaId, userId?)
activate MangaService

opt Invalid mangaId
  MangaService --> MangaController: 4.1. NotFoundException
  MangaController --> Router: 4.2. HTTP error
  Router --> UI: 4.3. Show error
  UI --> User: 4.4. Show error
end

MangaService -> MangaModel: 5. findById().populate(author)
activate MangaModel
MangaModel -> MongoDB: 6. query manga
activate MongoDB
MongoDB --> MangaModel: 7. manga data
deactivate MongoDB
MangaModel --> MangaService: 8. return manga
deactivate MangaModel

opt Manga not found
  MangaService --> MangaController: 8.1. NotFoundException
  MangaController --> Router: 8.2. HTTP error
  Router --> UI: 8.3. Show error
  UI --> User: 8.4. Show error
end

MangaService -> ChapterModel: 9. find published chapters
activate ChapterModel
ChapterModel -> MongoDB: 10. query chapters
activate MongoDB
MongoDB --> ChapterModel: 11. chapter list
deactivate MongoDB
ChapterModel --> MangaService: 12. return chapters
deactivate ChapterModel

opt User logged in
  MangaService -> ChapterPurchaseModel: 12.1. find purchased chapters
  activate ChapterPurchaseModel
  ChapterPurchaseModel -> MongoDB: 12.2. query purchases
  activate MongoDB
  MongoDB --> ChapterPurchaseModel: 12.3. purchased chapters
  deactivate MongoDB
  ChapterPurchaseModel --> MangaService: 12.4. return purchases
  deactivate ChapterPurchaseModel
end

MangaService -> MangaService: 13. map chapters (locked / purchased)
activate MangaService
MangaService -> RatingModel: 14. aggregate rating summary
deactivate MangaService
activate RatingModel
RatingModel -> MongoDB: 15. aggregate ratings
activate MongoDB
MongoDB --> RatingModel: 16. rating summary
deactivate MongoDB
RatingModel --> MangaService: 17. return summary
deactivate RatingModel

MangaService --> MangaController: 18. return manga detail
deactivate MangaService

MangaController --> Router: 19. HTTP response
deactivate MangaController

Router --> UI: 20. Response data
deactivate Router
UI --> User: 21. Show manga detail
deactivate UI
deactivate User
@enduml
