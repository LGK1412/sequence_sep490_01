@startuml
skinparam {
  ActorBackgroundColor #FFFFFF
  BoundaryBackgroundColor #FFFFFF
  ControlBackgroundColor #FFFFFF
  EntityBackgroundColor #FFFFFF
  DatabaseBackgroundColor #FFFFFF
  ActorBorderColor black
  BoundaryBorderColor black
  ControlBorderColor black
  EntityBorderColor black
  DatabaseBorderColor black
}

actor User
boundary "Notification Page" as UI
boundary Router
control NotificationController as NC
control NotificationService as NS
database MongoDB

User -> UI: 1. Click "View all notifications"
activate User
activate UI

UI -> Router: 2. GET /api/notification/get-all-noti-for-user/{id}
activate Router

Router -> NC: 3. getAllNotiForUser(id, req)
activate NC
NC -> NC: 4. Guard check (AccessToken + Roles)\n+ extract uid from token

alt 5. Missing userId in token
  NC --> Router: 5.1 400 BadRequest
  Router --> UI: 5.2 Show auth error
else 6. OK
  alt 6.1 User ID mismatch (id != uid)
    NC --> Router: 6.1.1 400 BadRequest
    Router --> UI: 6.1.2 Show mismatch error
  else 7. Match
    NC -> NS: 7.1 getAllNotiForUser(uid, payload)
    activate NS

    NS -> NS: 7.2 checkUser(payload.user_id)
    alt 7.3 Invalid user / banned / no permission
      NS --> NC: 7.3.1 400 error
    else 8. OK
      NS -> MongoDB: 8.1 find({receiver_id}).sort(createdAt:-1)
      activate MongoDB
      MongoDB --> NS: 8.2 noti list (may be empty)
      deactivate MongoDB
      NS --> NC: 8.3 return list
    end

    deactivate NS
    NC --> Router: 9. HTTP response
    Router --> UI: 10. Render list / empty state
  end
end

deactivate NC
deactivate Router
deactivate UI
deactivate User
@enduml