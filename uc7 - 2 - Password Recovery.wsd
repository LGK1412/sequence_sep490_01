@startuml
skinparam {
    ActorBackgroundColor #FFFFFF
    BoundaryBackgroundColor #FFFFFF
    ControlBackgroundColor #FFFFFF
    EntityBackgroundColor #FFFFFF
    DatabaseBackgroundColor #FFFFFF

    ActorBorderColor black
    BoundaryBorderColor black
    ControlBorderColor black
    EntityBorderColor black
    DatabaseBorderColor black
}

actor User
boundary "Reset Password UI" as UI
boundary Router
control AuthController
control AuthService
control JwtService
control UserService
entity UserModel
database MongoDB

User -> UI: 1. Submit new password + verification code
activate User
activate UI

UI -> Router: 2. POST /auth/verify-forgot-password
activate Router

Router -> AuthController: 3. verificationForgotPassword(code, password)
activate AuthController

AuthController -> AuthService: 4. verificationForgotPassword(token, password)
activate AuthService

opt Missing token
    AuthService --> AuthController: 4.1. BadRequestException
    AuthController --> Router: 4.2. Return error
    Router --> UI: 4.3. Return error
    UI --> User: 4.4. Show error
end

AuthService -> JwtService: 5. verify(token)
activate JwtService
opt Invalid / expired token
    JwtService --> AuthService: 5.1. Return error
    AuthService --> AuthController: 5.2. BadRequestException
    AuthController --> Router: 5.3. Return error
    Router --> UI: 5.4. Return error
    UI --> User: 5.5. Show error
end
JwtService --> AuthService: 6. payload
deactivate JwtService

opt Invalid payload
    AuthService --> AuthController: 6.1. BadRequestException
    AuthController --> Router: 6.2. BadRequestException
    Router --> UI: 6.3. Return error
    UI --> User: 6.4. Show error
end

AuthService -> UserService: 7. findByEmail(payload.email)
activate UserService
UserService -> UserModel: 8. findOne(email)
activate UserModel
UserModel -> MongoDB: 9. query user
activate MongoDB
MongoDB --> UserModel: 10. user / null
deactivate MongoDB
UserModel --> UserService: 11. user
deactivate UserModel
UserService --> AuthService: 12. user
deactivate UserService

alt User invalid / banned / google / not verified
    AuthService --> AuthController: 12.1.1. BadRequestException
    AuthController --> Router: 12.1.2. Return error
    Router --> UI: 12.1.3. Return error
    UI --> User: 12.1.4. Show error
else Verification code mismatch
    AuthService --> AuthController: 12.2.1. BadRequestException
    AuthController --> Router: 12.2.2. Return error
    Router --> UI: 12.2.3. Return error
    UI --> User: 12.2.4. Show error
end

AuthService -> AuthService: 13. hashPassword(password)
activate AuthService
AuthService -> UserService: 14. changePasswordForgot(newPassword, email)
deactivate AuthService
activate UserService
UserService -> UserModel: 15. update password
activate UserModel
UserModel -> MongoDB: 16. update document
activate MongoDB
MongoDB --> UserModel: 17. result
deactivate MongoDB
UserModel --> UserService: 18. return result
deactivate UserModel
UserService --> AuthService: 19. return result
deactivate UserService

alt Update failed
    AuthService --> AuthController: 19.1. BadRequestException
    AuthController --> Router: 19.2. Return error
    Router --> UI: 19.3. Return error
    UI --> User: 19.4. Show error
end

AuthService --> AuthController: 20. success response
deactivate AuthService

AuthController --> Router: 21. HTTP response
deactivate AuthController
Router --> UI: 22. Show success message
deactivate Router
UI --> User: 23. Password updated successfully
deactivate UI
deactivate User
@enduml
