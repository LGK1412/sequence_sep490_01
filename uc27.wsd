@startuml
skinparam {
  ActorBackgroundColor #FFFFFF
  BoundaryBackgroundColor #FFFFFF
  ControlBackgroundColor #FFFFFF
  EntityBackgroundColor #FFFFFF
  DatabaseBackgroundColor #FFFFFF
  ActorBorderColor black
  BoundaryBorderColor black
  ControlBorderColor black
  EntityBorderColor black
  DatabaseBorderColor black
}

actor User
boundary "Story Detail Page" as UI
boundary Router
control MangaController as MC
control MangaService as MS
database MongoDB

User -> UI: 1. Select a story
activate User
activate UI

UI -> Router: 2. GET /api/manga/detail/{storyId}
activate Router

Router -> MC: 3. getMangaDetail(req, id)
activate MC
MC -> MC: 4. Optional token\nExtract userId if exists

MC -> MS: 5. findMangaDetail(storyId, userId?)
activate MS

MS -> MongoDB: 6. findById(storyId).populate(authorId)
activate MongoDB
MongoDB --> MS: 7. manga / null
deactivate MongoDB

alt 8. Manga not found (or invalid id)
  MS --> MC: 8.1 Throw NotFoundException (Manga not found)
  MC --> Router: 8.2 HTTP 404
  Router --> UI: 8.3 Show "Story not found"
else 9. Found
  MS -> MongoDB: 9.1 find chapters (is_published=true)
  activate MongoDB
  MongoDB --> MS: 9.2 chapters
  deactivate MongoDB

  alt 10. User is logged in (userId exists)
    MS -> MongoDB: 10.1 find purchases by userId
    activate MongoDB
    MongoDB --> MS: 10.2 purchasedChapterIds
    deactivate MongoDB
  end

  MS -> MongoDB: 11. rating summary aggregate
  activate MongoDB
  MongoDB --> MS: 11.1 {count, avgRating}
  deactivate MongoDB

  MS --> MC: 12. Return story detail data
  MC --> Router: 13. HTTP 200
  Router --> UI: 14. Display story detail page
end

deactivate MS
deactivate MC
deactivate Router
deactivate UI
deactivate User
@enduml