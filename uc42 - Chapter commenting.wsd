@startuml
skinparam {
    ActorBackgroundColor #FFFFFF
    BoundaryBackgroundColor #FFFFFF
    ControlBackgroundColor #FFFFFF
    EntityBackgroundColor #FFFFFF
    DatabaseBackgroundColor #FFFFFF

    ActorBorderColor black
    BoundaryBorderColor black
    ControlBorderColor black
    EntityBorderColor black
    DatabaseBorderColor black
}

actor User
boundary "Chapter Comment Form (UI)" as UI
boundary Router
control CommentController
control CommentService
control ChapterService
control MangaService
control UserService
control NotificationService
control EventEmitter
entity CommentModel
entity UserModel
database MongoDB

User -> UI: 1. Write comment & submit
activate User
activate UI

UI -> Router: 2. POST /create-comment
activate Router

Router -> CommentController: 3. createCommentChapter()
activate CommentController

opt Token Invalid
    CommentController --> Router: 3.1.1. 401 Unauthorized
    Router --> UI: 3.1.2. Show error
    UI --> User: 3.1.3. Show error
end

CommentController -> CommentService: 5. createCommentChapter(dto, payload)

activate CommentService
CommentService -> UserService: 6. find user
activate UserService
UserService -> UserModel: 7. findById(userId)
activate UserModel
UserModel -> MongoDB: 8. Find user
activate MongoDB
MongoDB --> UserModel: 9. return user data
deactivate MongoDB
UserModel --> UserService: 10. return user data
deactivate UserModel
UserService --> CommentService: 11. return user data
deactivate UserService

alt User Not Found
    CommentService --> CommentController: 3.1.1. Throw error
    CommentController --> Router: 3.1.2. 401 Unauthorized
    Router --> UI: 3.1.3. Show error
    UI --> User: 3.1.4. Show error
else User is banned
    CommentService --> CommentController: 3.2.1. Throw error
    CommentController --> Router: 3.2.2. 401 Unauthorized
    Router --> UI: 3.2.3. Show error
    UI --> User: 3.2.4. Show error
end

CommentService -> CommentService: 7. Validate chapter_id
activate CommentService

opt Invalid chapter_id
    CommentService --> CommentController: 7.1.1. Throw error
    deactivate CommentService
    CommentController --> Router: 7.1.2. 400 Bad Request
    Router --> UI: 7.1.3. Show error
    UI --> User: 7.1.4. Show error
end

CommentService -> CommentModel: 8. Create new comment
activate CommentModel
CommentModel -> MongoDB: 9. save comment
activate MongoDB
MongoDB --> CommentModel: 10. Saved comment
deactivate MongoDB
CommentModel --> CommentService: 11. savedComment
deactivate CommentModel

opt Failed to save comment
    CommentService --> CommentController: 11.1. Throw error
    CommentController --> Router: 11.2. 500 Internal Server Error
    Router --> UI: 11.3. Show error
    UI --> User: 11.4. Show error
end

CommentService -> ChapterService: 12. getChapterById(chapterId)
activate ChapterService
ChapterService -> MongoDB: 13. Find chapter
activate MongoDB
MongoDB --> ChapterService: 14. Chapter data
deactivate MongoDB
ChapterService --> CommentService: 15. Chapter
deactivate ChapterService

alt Chapter not found
    CommentService --> CommentController: 15.1. Throw error
    CommentController --> Router: 15.2. 404 Not Found
    Router --> UI: 15.3. Show error
    UI --> User: 15.4. Show error
end

CommentService -> MangaService: 16. getAuthorByMangaIdForCommentChapter(mangaId)
activate MangaService
MangaService -> MongoDB: 17. Find manga & authorId
activate MongoDB
MongoDB --> MangaService: 18. Manga data
deactivate MongoDB
MangaService --> CommentService: 19. Manga + authorId
deactivate MangaService

CommentService -> UserService: 20. getUserById(authorId)
activate UserService
UserService -> MongoDB: 21. Find author
activate MongoDB
MongoDB --> UserService: 22. return author data
deactivate MongoDB
UserService --> CommentService: 23. Return author data
deactivate UserService

opt Author exists
    CommentService -> EventEmitter: 23.1. Emit comment_count
    activate EventEmitter
    deactivate EventEmitter

    CommentService -> NotificationService: 23.2. createNotification(dto)
    activate NotificationService
    NotificationService --> CommentService: 23.3. send_noti_result
    deactivate NotificationService

    CommentService -> UserService: 23.4. removeDeviceId(authorId, send_noti_result)
    activate UserService
    UserService --> CommentService: 23.5. Remove invalid devices
    deactivate UserService
    CommentService --> CommentController: 23.6. Return success
    CommentController --> Router: 23.7. HTTP response
    Router --> UI: 23.8. Comment created
    UI --> User: 23.9. Show success
end

CommentService --> CommentController: 24. Return success
deactivate CommentService

CommentController --> Router: 25. HTTP response
deactivate CommentController
Router --> UI: 26. Comment created
deactivate Router
UI --> User: 27. Show success
deactivate UI
deactivate User
@enduml
