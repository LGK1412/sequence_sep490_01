@startuml
skinparam {
    ActorBackgroundColor #FFFFFF
    BoundaryBackgroundColor #FFFFFF
    ControlBackgroundColor #FFFFFF
    EntityBackgroundColor #FFFFFF
    DatabaseBackgroundColor #FFFFFF

    ActorBorderColor black
    BoundaryBorderColor black
    ControlBorderColor black
    EntityBorderColor black
    DatabaseBorderColor black
}

actor User
boundary "Manga Rating Form (UI)" as UI
boundary Router
control RatingController
control RatingService
control EventEmitter
entity RatingModel
database MongoDB

User -> UI: 1. Submit rating & comment
activate User
activate UI

UI -> Router: 2. POST /rating/upsert
activate Router

Router -> RatingController: 3. upsert()
activate RatingController

alt mangaId missing
    RatingController --> Router: 3.1.1. HTTP response (400 Bad Request)
    Router --> UI: 3.1.2. Show error message
    UI --> User: 3.1.3. Error displayed
else Invalid mangaId
    RatingController --> Router: 3.2.1. HTTP response (400 Bad Request)
    Router --> UI: 3.2.2. Show error message
    UI --> User: 3.2.3. Error displayed
else Rating missing
    RatingController --> Router: 3.3.1. HTTP response (400 Bad Request)
    Router --> UI: 3.3.2. Show error message
    UI --> User: 3.3.3. Error displayed
else Comment missing
    RatingController --> Router: 3.4.1. HTTP response (400 Bad Request)
    Router --> UI: 3.4.2. Show error message
    UI --> User: 3.4.3. Error displayed

end

RatingController -> RatingService: 4. upsertRating(userId, mangaId, rating, comment)

activate RatingService
opt Rating out of range
    RatingService --> RatingController: 4.1. Error (Rating out of range)
    RatingController --> Router: 4.2. HTTP response (400 Bad Request)
    Router --> UI: 4.3. Show error message
    UI --> User: 4.4. Error displayed
end

RatingService -> RatingModel: 5. findOneAndUpdate(userId, mangaId)
activate RatingModel
RatingModel -> MongoDB: 6. Upsert rating document
activate MongoDB
MongoDB --> RatingModel: 7. Rating document
deactivate MongoDB
RatingModel --> RatingService: 8. Rating result
deactivate RatingModel

RatingService -> EventEmitter: 9. Emit rating_count
activate EventEmitter
deactivate EventEmitter
RatingService --> RatingController: 10. Return rating document
deactivate RatingService

RatingController --> Router: 11. HTTP response (success)
deactivate RatingController
Router --> UI: 12. Show rating result
deactivate Router
UI --> User: 13. Rating saved
deactivate UI
deactivate User
@enduml
