@startuml
skinparam {
    ActorBackgroundColor #FFFFFF
    BoundaryBackgroundColor #FFFFFF
    ControlBackgroundColor #FFFFFF
    EntityBackgroundColor #FFFFFF
    DatabaseBackgroundColor #FFFFFF

    ActorBorderColor black
    BoundaryBorderColor black
    ControlBorderColor black
    EntityBorderColor black
    DatabaseBorderColor black
}

actor Admin
boundary "Style Management UI" as UI
boundary Router
control StylesController
control AccessTokenGuard
control RolesGuard
control StylesService
entity StylesModel
database MongoDB

Admin -> UI: 1. Open "Add Style" dialog + submit form
activate Admin
activate UI

UI -> UI: 2. Client validate (name, description)

opt Client validation failed
    UI --> Admin: 2.1. Show inline error
end
    UI -> Router: 3. POST /styles
    activate Router

Router -> AccessTokenGuard: 4. canActivate(request)
activate AccessTokenGuard
opt Token invalid
    AccessTokenGuard --> Router: 4.1. Deny
    Router --> UI: 4.1.1. 401 Unauthorized
    UI --> Admin: 4.1.2. Show error message
end
AccessTokenGuard --> Router: 5. Allow
deactivate AccessTokenGuard

Router -> RolesGuard: 6. checkRole(ADMIN)
activate RolesGuard
opt Role invalid
    RolesGuard --> Router: 6.1. Deny
    Router --> UI: 6.1.1. 403 Forbidden
    UI --> Admin: 6.1.2. Show error message
end
RolesGuard --> Router: 7. Allow
deactivate RolesGuard

Router -> StylesController: 8. create(dto)
activate StylesController

StylesController -> StylesService: 9. create(body)
activate StylesService

StylesService -> StylesModel: 10. create(style)
activate StylesModel
StylesModel -> MongoDB: 11. insert document
activate MongoDB
MongoDB --> StylesModel: 12. Saved document
deactivate MongoDB
StylesModel --> StylesService: 13. Created style
deactivate StylesModel
opt Duplicate name or DB error
    StylesService --> StylesController: 13.3. Throw error
    StylesController --> Router: 13.4. HTTP 400/500
    Router --> UI: 13.5. Create failed
    UI --> Admin: 13.6. Show error message
end

StylesService --> StylesController: 14. Created style
deactivate StylesService
StylesController --> Router: 15. HTTP 201 response
deactivate StylesController
Router --> UI: 16. Return created style
deactivate Router
UI --> Admin: 17. Create style success
deactivate UI
deactivate Admin

@enduml